---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import FinalCTA from '../../components/home/FinalCTA.astro';
import { certifications, testResults, standards, constructionFacts } from '../../data/brand';
---

<BaseLayout
  title="Quality Standards & Test Results"
  description="Prominance uPVC profile test results: flexural modulus, impact strength, accelerated weathering and more — certified by SKZ-Germany, BSI-UK, SGS and CIPET."
>
  <section class="bg-surface-alt py-16 sm:py-24">
    <div class="container-prom flex flex-col gap-6">
      <SectionHeading
        eyebrow="Quality standards"
        heading="The test results behind the claims."
        description="Every number below comes from an independent accreditation body, tested against international standards, not Prominance's own lab."
      />
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-prom flex flex-col gap-10">
      <h2 class="reveal text-2xl font-extrabold text-ink sm:text-3xl">Accreditation bodies</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {certifications.map((c, i) => (
          <div class="reveal rounded-2xl border border-border bg-white p-6" data-reveal-delay={i * 80}>
            <span class="text-base font-extrabold text-primary-700">{c.body}</span>
            <p class="mt-2 text-sm leading-relaxed text-ink-muted">{c.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-surface-alt py-16 sm:py-20">
    <div class="container-prom flex flex-col gap-8">
      <div class="reveal flex flex-col gap-2">
        <h2 class="text-2xl font-extrabold text-ink sm:text-3xl">Mechanical & durability test results</h2>
        <p class="text-ink-muted">Measured result vs. the minimum standard required to pass.</p>
      </div>
      <div class="reveal overflow-x-auto rounded-2xl border border-border bg-white">
        <table class="w-full min-w-[520px] border-collapse text-left">
          <thead>
            <tr class="border-b border-border">
              <th class="p-4 text-sm font-bold text-ink-muted">Metric</th>
              <th class="p-4 text-sm font-bold text-ink-muted">Prominance result</th>
              <th class="p-4 text-sm font-bold text-ink-muted">Requirement</th>
            </tr>
          </thead>
          <tbody>
            {testResults.map((r, i) => (
              <tr class={i % 2 === 0 ? 'bg-surface-alt/60' : ''}>
                <td class="p-4 text-sm font-semibold text-ink">{r.metric}</td>
                <td class="p-4 text-sm font-bold text-accent-700">{r.result}</td>
                <td class="p-4 text-sm text-ink-muted">{r.requirement}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-prom grid grid-cols-1 gap-10 lg:grid-cols-2">
      <div class="reveal flex flex-col gap-4">
        <h2 class="text-2xl font-extrabold text-ink sm:text-3xl">Standards referenced</h2>
        <div class="flex flex-wrap gap-2">
          {standards.map((s) => (
            <span class="rounded-full border border-border bg-white px-3.5 py-1.5 text-xs font-semibold text-ink-muted">{s}</span>
          ))}
        </div>
      </div>
      <div class="reveal flex flex-col gap-4" data-reveal-delay="100">
        <h2 class="text-2xl font-extrabold text-ink sm:text-3xl">Construction, verified</h2>
        <ul class="flex flex-col gap-2.5 text-sm text-ink-muted">
          <li><strong class="text-ink">Profile walls:</strong> {constructionFacts.wallThickness}</li>
          <li><strong class="text-ink">Reinforcement:</strong> {constructionFacts.steelReinforcement}</li>
          <li><strong class="text-ink">Joints:</strong> {constructionFacts.joints}</li>
          <li><strong class="text-ink">Weather seal:</strong> {constructionFacts.weatherSeal}</li>
          <li><strong class="text-ink">Raw material:</strong> {constructionFacts.rawMaterial}, {constructionFacts.leadContent}</li>
        </ul>
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
