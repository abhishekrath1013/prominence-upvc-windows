---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import ProductShowcase from '../../components/home/ProductShowcase.astro';
import FinalCTA from '../../components/home/FinalCTA.astro';
import { contact } from '../../data/brand';
import heroImg from '../../assets/images/stock/hero-modern-home-dusk.jpg';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  return cities.map((c) => ({ params: { city: c.id }, props: { entry: c } }));
}

const { entry } = Astro.props;
const c = entry.data;
---

<BaseLayout
  title={`uPVC Windows & Doors in ${c.name}`}
  description={`Prominance uPVC windows and doors in ${c.name}, ${c.region}. ${c.intro}`}
>
  <section class="relative flex min-h-[40vh] items-end overflow-hidden bg-neutral-900">
    <Image src={heroImg} alt={`Prominance in ${c.name}`} class="absolute inset-0 h-full w-full object-cover" widths={[800, 1600]} sizes="100vw" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/85 via-neutral-950/30 to-neutral-950/10" aria-hidden="true"></div>
    <div class="container-prom reveal relative z-10 flex flex-col gap-3 pb-12 pt-28">
      <span class="text-xs font-bold uppercase tracking-[0.14em] text-accent-400">{c.region}{c.isHQ ? ' · Headquarters' : ''}</span>
      <h1 class="text-4xl font-extrabold text-white sm:text-5xl">Prominance in {c.name}</h1>
    </div>
  </section>

  <section class="py-16 sm:py-20">
    <div class="container-prom flex flex-col gap-8">
      <SectionHeading eyebrow={`Why ${c.name}`} heading={`Built for ${c.name}'s conditions.`} description={c.intro} />
      <div class="flex flex-wrap gap-3">
        <Button href="/quote/" size="lg">Get a Quote in {c.name}</Button>
        <Button href={contact.tollFreeHref} variant="ghost" size="lg">Call {contact.tollFree}</Button>
      </div>
    </div>
  </section>

  <ProductShowcase category="window" />
  <FinalCTA />
</BaseLayout>
