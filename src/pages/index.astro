---
// Home page — the aluminium site's homepage structure, rebuilt for uPVC in a light theme:
//   hero (+ proof strip) → "Let Life In. Keep the Worries Out." → frame collection (brochure sections) → statement + factory
//   → 20-year warranty → every component has a purpose → tested to the limit → contact → footer (BaseLayout)
// Copy lives in src/data/home.ts (sourced from docs/Prominance-Website-Content.docx and the brochures).
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hm/Hero.astro';
import Comfort from '../components/hm/Comfort.astro';
import Frames from '../components/hm/Frames.astro';
import Craft from '../components/hm/Craft.astro';
import Warranty from '../components/hm/Warranty.astro';
import Anatomy from '../components/hm/Anatomy.astro';
import Lab from '../components/hm/Lab.astro';
import Contact from '../components/hm/Contact.astro';
---

<BaseLayout
  title="uPVC Windows & Doors Manufacturer in India | Prominance"
  description="Lead-free uPVC windows and doors made in Coimbatore, tested for 25,000 hours. Quiet, cool, termite-proof, with a 20-year colour warranty. Get a quote."
  nav="none"
>
  <!-- Stacked scroll only here: the hero stays docked while "Let Life In" slides over it. Everything else scrolls normally. -->
  <div class="hm-stack">
    <Hero />
    <Comfort />
  </div>
  <Frames />
  <Craft />
  <Warranty />
  <Anatomy />
  <Lab />
  <Contact />

  <script>
    import '../scripts/home';
  </script>
</BaseLayout>
