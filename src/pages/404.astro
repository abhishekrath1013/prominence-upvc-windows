---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page Not Found" description="This page couldn't be found." noIndex>
  <section class="flex min-h-[60vh] items-center py-20">
    <div class="container-prom flex flex-col items-center gap-5 text-center">
      <span class="text-sm font-bold uppercase tracking-wide text-accent-700">404</span>
      <h1 class="text-3xl font-extrabold text-ink sm:text-4xl">We couldn't find that page.</h1>
      <p class="max-w-md text-ink-muted">It may have moved. Try one of these instead.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <Button href="/" size="lg">Back to Home</Button>
        <Button href="/windows/" variant="ghost" size="lg">Explore Windows</Button>
      </div>
    </div>
  </section>
</BaseLayout>
