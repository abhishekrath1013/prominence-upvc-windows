---
import { journey, offer } from '../../data/copy';
---
<section class="bg-bone-deep py-28 md:py-44">
  <div class="container-prom">
    <p class="eyebrow mb-5">{offer.name}</p>
    <h2 class="display reveal max-w-4xl text-[clamp(2.2rem,5vw,4.4rem)]">{offer.headline}</h2>
    <ol class="mt-20 grid gap-10 md:grid-cols-4" data-stagger>
      {journey.map((j) => (
        <li class="reveal border-t border-ink pt-6">
          <span class="eyebrow">{j.step}</span>
          <h3 class="display mt-4 text-3xl">{j.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-muted">{j.body}</p>
        </li>
      ))}
    </ol>
    <div class="mt-24 grid gap-12 md:grid-cols-12">
      <ul class="grid gap-x-10 gap-y-1 text-ink md:col-span-8 md:grid-cols-2">
        {offer.includes.map((x) => (
          <li class="flex gap-3 border-b border-ink/10 py-3 text-sm"><span class="text-stone" aria-hidden="true">+</span>{x}</li>
        ))}
      </ul>
      <div class="md:col-span-4 md:text-right">
        <a href={offer.cta.href} class="link-arrow">{offer.cta.label} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>
