---
import { Image } from 'astro:assets';
import windows from '../../assets/images/brochure/photos/optima-casement-life.jpg';
import doors from '../../assets/images/brochure/photos/door-sliding-life.jpg';
import finishes from '../../assets/images/brochure/photos/lam-forest.jpg';
import { systems } from '../../data/copy';
const items = [
  { ...systems.windows, img: windows, alt: 'Prominance casement window in a home' },
  { ...systems.doors, img: doors, alt: 'Prominance sliding door in a living space' },
  { ...systems.finishes, img: finishes, alt: 'Laminated uPVC window in a woodgrain finish' },
];
---
<section class="bg-bone pb-28 pt-24 md:pb-44">
  <div class="container-prom">
    <div class="mb-14 flex items-end justify-between gap-6">
      <h2 class="display reveal text-[clamp(2.2rem,5.5vw,4.5rem)]">Three ways<br />to let in the light.</h2>
      <p class="eyebrow hidden md:block">The systems</p>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {items.map((it, i) => (
        <a href={it.href} class="group reveal relative block overflow-hidden bg-ink-deep text-bone" style="aspect-ratio:3/4">
          <Image src={it.img} alt={it.alt} class="h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-105" widths={[600, 900, 1200]} sizes="(min-width:768px) 33vw, 100vw" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink-deep/75 via-transparent to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 flex items-end justify-between p-7">
            <div>
              <p class="eyebrow !text-bone/60">0{i + 1}</p>
              <h3 class="display mt-2 text-4xl">{it.title}</h3>
              <p class="mt-2 max-w-[16rem] text-sm text-bone/75">{it.line}</p>
            </div>
            <span class="mb-1 text-2xl transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
