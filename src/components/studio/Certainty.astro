---
import { Image } from 'astro:assets';
import product from '../../assets/images/brochure/photos/extrusion-line.jpg';
import trust from '../../assets/images/brochure/photos/testing-machine.jpg';
import company from '../../assets/images/brochure/photos/factory-aerial.jpg';
import { certainty } from '../../data/copy';
const rows = [
  { ...certainty.product, img: product, alt: 'Profile extrusion line at the Prominance factory' },
  { ...certainty.trust, img: trust, alt: 'Laboratory testing machine used for uPVC profile testing' },
  { ...certainty.company, img: company, alt: 'Aerial view of the Prominance factory in Coimbatore' },
];
---
<section class="bg-ink-deep py-24 text-bone md:py-40">
  <div class="container-prom flex flex-col gap-28 md:gap-44">
    {rows.map((r, i) => (
      <article class="grid items-center gap-10 md:grid-cols-12 md:gap-16">
        <div class={`img-reveal overflow-hidden md:col-span-7 ${i % 2 ? 'md:order-2' : ''}`} style="aspect-ratio:4/3">
          <Image src={r.img} alt={r.alt} class="h-full w-full object-cover" widths={[700, 1100, 1600]} sizes="(min-width:768px) 58vw, 100vw" />
        </div>
        <div class="reveal md:col-span-5">
          <p class="eyebrow mb-5 !text-bone/50">0{i + 1} · {r.label}</p>
          <h2 class="display text-[clamp(2rem,4.2vw,3.6rem)]">{r.title}</h2>
          <p class="mt-6 max-w-md text-base leading-relaxed text-bone/70">{r.body}</p>
        </div>
      </article>
    ))}
  </div>
</section>
