---
import { Image } from 'astro:assets';
import img from '../../assets/images/brochure/photos/lam-black-living.jpg';
import { hero } from '../../data/copy';
---
<section class="relative h-[100svh] min-h-[640px] w-full overflow-hidden bg-ink-deep text-bone">
  <div class="absolute inset-0" data-parallax="0.08">
    <Image src={img} alt="Living room with dark-framed Prominance casement windows opening onto a green forest" class="h-full w-full scale-110 object-cover" widths={[1200, 1800, 2400]} sizes="100vw" loading="eager" />
  </div>
  <div class="absolute inset-0 bg-gradient-to-t from-ink-deep/80 via-ink-deep/20 to-ink-deep/30"></div>
  <div class="container-prom relative flex h-full flex-col justify-end pb-16 md:pb-24">
    <p class="eyebrow mb-6 !text-bone/70">{hero.eyebrow}</p>
    <h1 class="display text-[clamp(3.2rem,10vw,9rem)]">
      {hero.headline.map((line, li) => (
        <span class="block">
          {line.split(' ').map((w, i) => (
            <span class="hero-word"><span style={`--i:${li * 3 + i}`}>{w}&nbsp;</span></span>
          ))}
        </span>
      ))}
    </h1>
    <div class="mt-10 flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <p class="max-w-md text-base leading-relaxed text-bone/80 md:text-lg">{hero.sub}</p>
      <div class="flex flex-wrap gap-x-10 gap-y-4">
        <a href={hero.primaryCta.href} class="link-arrow">{hero.primaryCta.label} <span aria-hidden="true">→</span></a>
        <a href={hero.secondaryCta.href} class="link-arrow opacity-70 hover:opacity-100">{hero.secondaryCta.label} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>
