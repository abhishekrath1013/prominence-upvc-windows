---
interface Props {
  variant?: 'primary' | 'accent' | 'neutral';
  class?: string;
}
const { variant = 'primary', class: className = '' } = Astro.props;

const variants = {
  primary: 'border-primary-700/20 text-primary-700',
  accent: 'border-accent-700/30 text-accent-800',
  neutral: 'border-ink/15 text-ink-muted',
};
---

<span class={`inline-flex items-center gap-1.5 rounded-full border bg-white/50 px-3.5 py-1.5 text-[0.62rem] font-medium uppercase tracking-[0.22em] ${variants[variant]} ${className}`}>
  <slot />
</span>
