---
interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
  align?: 'left' | 'center';
  light?: boolean;
  class?: string;
}

const { eyebrow, heading, description, align = 'left', light = false, class: className = '' } = Astro.props;
const alignClass = align === 'center' ? 'text-center items-center mx-auto' : 'text-left items-start';
---

<div class={`reveal flex max-w-3xl flex-col gap-5 ${alignClass} ${className}`}>
  {
    eyebrow && (
      <span class={`eyebrow ${light ? '!text-accent-300' : ''}`}>
        {eyebrow}
      </span>
    )
  }
  <h2
    class={`text-[clamp(2.4rem,5vw,4.4rem)] leading-[1.02] ${light ? 'text-white' : 'text-ink'}`}
  >
    {heading}
  </h2>
  {description && <p class={`max-w-xl text-[1.05rem] leading-[1.7] ${light ? 'text-white/75' : 'text-ink-muted'}`}>{description}</p>}
</div>
