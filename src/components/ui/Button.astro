---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'white';
  size?: 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit';
  arrow?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  type = 'button',
  arrow = true,
} = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-3 rounded-full font-medium uppercase transition-all duration-500 ease-[var(--ease-smooth)] focus-visible:outline-2 focus-visible:outline-offset-2';

const variants = {
  primary: 'bg-ink text-bone hover:bg-accent-700',
  secondary: 'bg-accent-700 text-white hover:bg-ink',
  ghost: 'bg-transparent text-ink border border-ink/30 hover:border-ink hover:bg-ink hover:text-bone',
  white: 'bg-white text-ink hover:bg-ink hover:text-bone',
};

const sizes = {
  md: 'px-7 py-3.5 text-[0.68rem] tracking-[0.2em]',
  lg: 'px-9 py-[1.15rem] text-[0.72rem] tracking-[0.22em]',
};

const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
const Tag = href ? 'a' : 'button';
---

<Tag class={classes} href={href} type={!href ? type : undefined}>
  <slot />
  {
    arrow && (
      <svg
        class="h-2.5 w-6 shrink-0 transition-transform duration-500 ease-[var(--ease-smooth)] group-hover:translate-x-1"
        viewBox="0 0 26 10"
        fill="none"
        aria-hidden="true"
      >
        <path d="M0 5h24M20 1l4 4-4 4" stroke="currentColor" stroke-width="1.1" />
      </svg>
    )
  }
</Tag>
