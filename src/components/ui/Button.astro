---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'white';
  size?: 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit';
  arrow?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  type = 'button',
  arrow = true,
} = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-all duration-200 ease-out focus-visible:outline-2 focus-visible:outline-offset-2';

const variants = {
  primary: 'bg-primary-700 text-white hover:bg-primary-800 active:bg-primary-900 shadow-[0_1px_2px_rgba(0,0,0,0.06)]',
  secondary: 'bg-accent-600 text-white hover:bg-accent-700 active:bg-accent-800',
  ghost: 'bg-transparent text-primary-700 border-2 border-primary-700 hover:bg-primary-50',
  white: 'bg-white text-primary-700 hover:bg-neutral-100',
};

const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
};

const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
const Tag = href ? 'a' : 'button';
---

<Tag class={classes} href={href} type={!href ? type : undefined}>
  <slot />
  {
    arrow && (
      <svg
        class="h-4 w-4 shrink-0 transition-transform duration-200 ease-out group-hover:translate-x-0.5"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</Tag>
