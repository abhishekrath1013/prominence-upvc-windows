---
// "Let Life In. Keep the Worries Out." — the client-approved four-tile section, in the aluminium "Unique solutions" layout:
// heading top-left, four frosted cards in a staggered grid, the last one full width. Copy is verbatim from the content doc.
import { Image } from 'astro:assets';
import bg from '../../assets/images/stock/open-living-dining-windows.jpg';
import { comfort } from '../../data/home';
---

<section class="hc" aria-labelledby="hc-title">
  <Image src={bg} alt="" class="hc__bg" data-hm="uq-bg" widths={[900, 1600]} sizes="115vw" loading="lazy" />
  <div class="hc__veil" aria-hidden="true"></div>

  <div class="hc__stage">
    <div class="hc__head">
      <h2 id="hc-title" class="hc__title" aria-label={comfort.titleLabel}>
        {
          comfort.title.map((l) => (
            <span class="ln" aria-hidden="true">
              <span class="ln__t" data-hm="uq-line">{l}</span>
            </span>
          ))
        }
      </h2>
      <p class="hc__intro" data-hm="uq-card">{comfort.intro}</p>
      <a href={comfort.cta.href} class="hc__cta" data-hm="uq-card">
        {comfort.cta.label}
        <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" stroke="currentColor" stroke-width="1.2"></path></svg>
      </a>
    </div>

    {
      comfort.cards.map((c, i) => (
        <article class={`hc__card hc__c${i + 1}`} data-hm="uq-card">
          <span class="hc__num" aria-hidden="true">{c.n}</span>
          <h3>{c.title[0]}<br />{c.title[1]}</h3>
          <div class="hc__body">
            <p>{c.text}</p>
            <p class="hc__proof"><span>Feature proof</span>{c.proof}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style is:global>
  /* One screen tall, like the aluminium "Unique solutions" section: the stage is drawn at 1326 × 1070 design units and
     scaled (--u) to whatever the viewport allows, so the heading and all four cards always fit without scrolling. */
  .hc {
    container-type: size;
    position: relative;
    z-index: 2;
    isolation: isolate;
    overflow: hidden;
    height: 100svh;
    min-height: 560px;
    background: #eef3f6;
    /* the hero is pinned beneath; this section slides over it */
    box-shadow: 0 -30px 60px -30px rgb(13 31 45 / 0.35);
  }
  .hc__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 50%;
  }
  .hc__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(244 248 250 / 0.9) 0%, rgb(244 248 250 / 0.74) 55%, rgb(244 248 250 / 0.92) 100%),
      linear-gradient(90deg, rgb(244 248 250 / 0.7), transparent 60%);
  }

  /* two equal columns pinned to the side margins; the rows are the design's heights */
  .hc__stage {
    --u: calc(min(100cqw, 100cqh * 1326 / 1070) / 1326);
    --t-title: calc(50 * var(--u));
    --t-intro: calc(16.5 * var(--u));
    --t-cta: calc(12.5 * var(--u));
    --t-h3: calc(40 * var(--u));
    --t-body: calc(17 * var(--u));
    --t-proof: calc(14.5 * var(--u));
    --t-tag: calc(10 * var(--u));
    --t-num: calc(40 * var(--u));
    --pad-t: calc(40 * var(--u));
    --pad-x: calc(26 * var(--u));
    box-sizing: border-box;
    position: absolute;
    left: calc(110 * var(--u));
    right: calc(110 * var(--u));
    top: 50%;
    translate: 0 -50%;
    height: calc(1070 * var(--u));
    padding-top: calc(142 * var(--u));
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: calc(340 * var(--u)) calc(335 * var(--u)) calc(185 * var(--u));
    gap: calc(13 * var(--u)) calc(15 * var(--u));
    align-content: start;
  }
  .hc__head {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    padding: calc(4 * var(--u)) calc(30 * var(--u)) 0 0;
  }
  .hc__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-title);
    line-height: 1.02;
    letter-spacing: -0.045em;
    color: var(--color-brand-navy);
  }
  .hc__title .ln:nth-child(3) .ln__t {
    color: var(--color-brand-blue);
  }
  .hc__intro {
    margin-top: calc(18 * var(--u));
    max-width: calc(520 * var(--u));
    font-size: var(--t-intro);
    line-height: 1.62;
    color: rgb(11 43 64 / 0.78);
  }
  .hc__cta {
    margin-top: calc(16 * var(--u));
    display: inline-flex;
    align-items: center;
    gap: 0.9em;
    padding-bottom: 0.45em;
    border-bottom: 1px solid var(--color-brand-blue);
    font-size: var(--t-cta);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brand-blue);
    transition: gap 0.4s var(--ease-smooth);
  }
  .hc__cta:hover {
    gap: 1.6em;
  }
  .hc__card {
    position: relative;
    padding: var(--pad-t) var(--pad-x) 0;
    background: rgb(255 255 255 / 0.8);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    backdrop-filter: blur(10px) saturate(1.2);
    border: 1px solid rgb(255 255 255 / 0.9);
    box-shadow: 0 24px 50px -34px rgb(13 31 45 / 0.5);
  }
  .hc__c1 { grid-column: 2; grid-row: 1; }
  .hc__c2 { grid-column: 1; grid-row: 2; }
  .hc__c3 { grid-column: 2; grid-row: 2; }
  .hc__c4 {
    grid-column: 1 / -1;
    grid-row: 3;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: calc(15 * var(--u));
    align-items: start;
  }
  .hc__num {
    position: absolute;
    top: calc(10 * var(--u));
    right: calc(22 * var(--u));
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-num);
    line-height: 1.2;
    color: var(--color-brand-blue);
  }
  .hc__card h3 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--t-h3);
    line-height: 1.16;
    letter-spacing: -0.04em;
    color: var(--color-brand-navy);
  }
  .hc__body {
    margin-top: calc(12 * var(--u));
    max-width: calc(480 * var(--u));
  }
  .hc__body p {
    font-size: var(--t-body);
    line-height: 1.6;
    color: rgb(11 43 64 / 0.72);
  }
  .hc__proof {
    margin-top: calc(14 * var(--u));
    padding-top: calc(12 * var(--u));
    border-top: 1px solid rgb(11 43 64 / 0.1);
    font-size: var(--t-proof) !important;
    line-height: 1.45 !important;
    font-weight: 600;
    color: var(--color-accent-700) !important;
  }
  .hc__proof span {
    display: block;
    margin-bottom: 0.2em;
    font-size: var(--t-tag);
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(11 43 64 / 0.45);
  }
  .hc__c4 .hc__body {
    margin-top: 0;
  }

  /* phone / small tablet: a plain stack instead of the scaled stage */
  @media (max-width: 860px) {
    .hc {
      container-type: normal;
      height: auto;
      min-height: 0;
    }
    .hc__stage {
      --t-title: clamp(2.4rem, 11vw, 3.6rem);
      --t-intro: 1rem;
      --t-cta: 0.72rem;
      --t-h3: clamp(1.6rem, 7vw, 2.2rem);
      --t-body: 0.98rem;
      --t-proof: 0.82rem;
      --t-tag: 0.62rem;
      --t-num: 1.9rem;
      --pad-t: 1.8rem;
      --pad-x: 1.25rem;
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      translate: none;
      height: auto;
      grid-template-columns: 1fr;
      grid-template-rows: none;
      padding: 4.5rem 1.25rem 3.5rem;
      gap: 0.75rem;
    }
    .hc__head,
    .hc__c1,
    .hc__c2,
    .hc__c3,
    .hc__c4 {
      grid-column: auto;
      grid-row: auto;
    }
    .hc__head {
      margin-bottom: 1rem;
      padding: 0;
    }
    .hc__intro {
      margin-top: 1.4rem;
      max-width: 30rem;
    }
    .hc__cta {
      margin-top: 1.6rem;
    }
    .hc__card {
      padding-bottom: 1.5rem;
    }
    .hc__body {
      margin-top: 0.9rem;
      max-width: 27rem;
    }
    .hc__proof {
      margin-top: 1rem;
      padding-top: 0.9rem;
    }
    .hc__num {
      top: 0.7rem;
      right: 1.25rem;
    }
    .hc__c4 {
      display: block;
    }
    .hc__c4 .hc__body {
      margin-top: 0.9rem;
    }
  }
</style>
