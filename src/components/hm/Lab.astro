---
// "Tested to the limit." — the aluminium "Built like a vault" screen: a three-line heading, a photograph standing in
// the middle of it, and a slowly looping row of cards. The cards are the profile's EN 12608 results, each with its lab.
import { Image } from 'astro:assets';
import photo from '../../assets/images/brochure/photos/testing-machine.jpg';
import { lab } from '../../data/home';

// the row is rendered twice, back to back, so the loop never shows a seam
const loop = [...lab.cards.map((c) => ({ ...c, dup: false })), ...lab.cards.map((c) => ({ ...c, dup: true }))];
---

<section class="hl" aria-labelledby="hl-title">
  <div class="hl__bg" aria-hidden="true"></div>
  <div class="hl__photo" data-hm="hl-photo" aria-hidden="true">
    <Image src={photo} alt="" widths={[700, 1100, 1400]} sizes="(max-width: 860px) 100vw, 62vw" loading="lazy" />
  </div>

  <div class="hl__stage">
    <h2 id="hl-title" class="hl__title" aria-label={lab.titleLabel}>
      {
        lab.title.map((l) => (
          <span class="ln" aria-hidden="true">
            <span class="ln__t" data-hm="hl-line">{l}</span>
          </span>
        ))
      }
    </h2>
    <div class="hl__side" data-hm="hl-fade">
      <p>{lab.sub}</p>
      <a href={lab.cta.href}>
        {lab.cta.label}
        <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" stroke="currentColor" stroke-width="1.2"></path></svg>
      </a>
    </div>
  </div>

  <div class="hl__rail" data-hm="hl-rail" aria-label="Profile test results, EN 12608-1:2016">
    <div class="hl__belt">
      {
        loop.map((c) => (
          <article class="hl__card" aria-hidden={c.dup ? 'true' : undefined}>
            <h3>{c.title[0]}<br />{c.title[1]}</h3>
            <p class="hl__big">{c.big}</p>
            <p class="hl__text">{c.text}</p>
            <p class="hl__lab">{c.lab}</p>
            <svg class="hl__icon" viewBox="0 0 92 92" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {c.icon === 'sun' && (
                <>
                  <circle cx="46" cy="46" r="15" />
                  <path d="M46 10v10M46 72v10M10 46h10M72 46h10M20.5 20.5l7 7M64.5 64.5l7 7M71.5 20.5l-7 7M27.5 64.5l-7 7" />
                </>
              )}
              {c.icon === 'hit' && (
                <>
                  <path d="M16 20h38v16H16z" />
                  <path d="M54 28h16M62 28V76" />
                  <path d="M30 54l8 8-8 8M18 62h20" />
                  <path d="M70 58l8-4M72 68l10 2M68 78l6 8" />
                </>
              )}
              {c.icon === 'weld' && (
                <>
                  <path d="M10 34h40v12H10z" />
                  <path d="M42 46h12v36H42z" />
                  <path d="M54 34l8-8M60 44l12-4M58 54l14 4" />
                </>
              )}
              {c.icon === 'leaf' && (
                <>
                  <path d="M20 70C14 40 34 16 74 14 76 54 56 74 26 72" />
                  <path d="M20 70c12-16 24-26 40-36" />
                </>
              )}
              {c.icon === 'flame' && (
                <>
                  <path d="M46 8c4 14 22 22 22 42a22 22 0 0 1-44 0c0-10 6-16 10-22 2 8 6 10 8 10-2-12 0-22 4-30Z" />
                  <path d="M46 52c6 6 8 10 8 14a8 8 0 0 1-16 0c0-4 4-8 8-14Z" />
                </>
              )}
              {c.icon === 'temp' && (
                <>
                  <path d="M38 14a8 8 0 0 1 16 0v36a16 16 0 1 1-16 0Z" />
                  <path d="M46 28v34" />
                  <circle cx="46" cy="66" r="6" />
                  <path d="M62 24h10M62 36h6M62 48h10" />
                </>
              )}
            </svg>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .hl {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    background: #f1f6f9;
    padding-bottom: clamp(2rem, 6svh, 4rem);
  }
  .hl__bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
      radial-gradient(ellipse 50% 60% at 78% 30%, rgb(7 110 161 / 0.14), transparent 70%),
      linear-gradient(180deg, #f7fafc, #e6eef3);
  }
  /* the lab photograph dissolves into the page from the left and the bottom */
  .hl__photo {
    position: absolute;
    z-index: -2;
    top: 0;
    right: 0;
    width: min(66%, 980px);
    height: 78%;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 42%), linear-gradient(180deg, #000 55%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 42%), linear-gradient(180deg, #000 55%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
    opacity: 0.92;
  }
  .hl__photo img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 40% 55%;
  }
  .hl__stage {
    position: relative;
    max-width: 1560px;
    width: 100%;
    margin-inline: auto;
    padding: clamp(5.5rem, 13svh, 9rem) clamp(1.25rem, 5vw, 5rem) 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
  }
  .hl__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.4rem, 10vw, 9.4rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: var(--color-brand-navy);
  }
  .hl__title .ln:nth-child(2) {
    margin-left: 0.34em;
  }
  .hl__title .ln:nth-child(3) {
    margin-left: 0.68em;
  }
  .hl__title .ln:nth-child(3) .ln__t {
    color: var(--color-brand-blue);
  }
  .hl__side {
    max-width: 22rem;
  }
  .hl__side p {
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(11 43 64 / 0.78);
  }
  .hl__side a {
    margin-top: 1.2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--color-brand-blue);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brand-blue);
    transition: gap 0.4s var(--ease-smooth);
  }
  .hl__side a:hover {
    gap: 1.5rem;
  }

  /* the cards drift left forever, very slowly; hovering (or focusing) the row holds them still */
  .hl__rail {
    position: relative;
    z-index: 3;
    overflow: hidden;
    padding-block: 0.5rem 1rem;
  }
  .hl__belt {
    display: flex;
    width: max-content;
    margin-left: clamp(1.25rem, 5vw, 5rem);
    animation: hl-drift 120s linear infinite;
    will-change: transform;
  }
  .hl__rail:hover .hl__belt,
  .hl__rail:focus-within .hl__belt {
    animation-play-state: paused;
  }
  @keyframes hl-drift {
    to {
      transform: translateX(-50%);
    }
  }
  .hl__card {
    position: relative;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: clamp(300px, 28vw, 410px);
    min-height: 320px;
    margin-right: 16px;
    padding: 2.1rem 1.9rem 1.6rem;
    background: rgb(255 255 255 / 0.86);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border: 1px solid rgb(255 255 255 / 0.95);
    box-shadow: 0 30px 60px -40px rgb(13 31 45 / 0.5);
    color: var(--color-brand-navy);
  }
  .hl__card h3 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.5rem, 2.2vw, 2.1rem);
    line-height: 1.16;
    letter-spacing: -0.04em;
  }
  .hl__big {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 3vw, 2.7rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-brand-blue);
  }
  .hl__text {
    margin-top: 0.8rem;
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgb(11 43 64 / 0.7);
  }
  .hl__lab {
    margin-top: 1.1rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent-700);
  }
  .hl__icon {
    position: absolute;
    right: 1.5rem;
    top: 1.7rem;
    width: 3.4rem;
    height: 3.4rem;
    color: rgb(7 110 161 / 0.55);
  }

  @media (prefers-reduced-motion: reduce) {
    .hl__belt {
      animation: none;
    }
    .hl__rail {
      overflow-x: auto;
    }
  }
  @media (max-width: 860px) {
    .hl {
      min-height: 0;
    }
    .hl__photo {
      width: 100%;
      height: 46%;
      opacity: 0.55;
      -webkit-mask-image: linear-gradient(180deg, #000 30%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 30%, transparent 100%);
    }
    .hl__belt {
      animation-duration: 90s;
    }
    .hl__title .ln:nth-child(2) {
      margin-left: 0.2em;
    }
    .hl__title .ln:nth-child(3) {
      margin-left: 0.4em;
    }
  }
</style>
