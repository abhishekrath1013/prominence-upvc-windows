---
// Statement + factory — the aluminium "Built with precision…" screen: a big uppercase statement over a pale texture, the
// factory aerial opening beneath it. Under the photograph, the six factory stations from the content doc.
import { Image } from 'astro:assets';
import factory from '../../assets/home/factory.webp';
import { craft } from '../../data/home';
---

<section class="hp" aria-labelledby="hp-title">
  <div class="hp__bg" aria-hidden="true"></div>

  <div class="hp__top">
    <h2 id="hp-title" class="hp__statement" aria-label={craft.statementLabel}>
      {
        craft.statement.map((l) => (
          <span class="ln" aria-hidden="true">
            <span class="ln__t" data-hm="hp-line">{l}</span>
          </span>
        ))
      }
    </h2>
    <a href={craft.cta.href} class="hp__cta" data-hm="hp-fade">
      {craft.cta.label}
      <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" stroke="currentColor" stroke-width="1.2"></path></svg>
    </a>
  </div>

  <div class="hp__factory" data-hm="hp-factory">
    <Image src={factory} alt={craft.alt} widths={[1200, 1800, 2400]} sizes="100vw" loading="lazy" />
    <ol class="hp__stations" aria-label="The six factory stations">
      {craft.stations.map((s, i) => <li><b>{String(i + 1).padStart(2, '0')}</b>{s}</li>)}
    </ol>
  </div>
</section>

<style is:global>
  .hp {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr;
    background: #f2f6f9;
  }
  /* pale paper with the faint profile line-work of the brochure cover */
  .hp__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 60% 50% at 85% 0%, rgb(7 110 161 / 0.1), transparent 70%),
      radial-gradient(ellipse 50% 50% at 0% 40%, rgb(66 155 70 / 0.08), transparent 70%),
      repeating-linear-gradient(135deg, rgb(11 43 64 / 0.035) 0 1px, transparent 1px 38px);
  }
  .hp__top {
    padding: clamp(5rem, 11svh, 8rem) clamp(1.25rem, 8.4vw, 7.5rem) clamp(2rem, 5svh, 3.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .hp__statement {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 5.4vw, 5rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: var(--color-brand-navy);
  }
  .hp__statement .ln:nth-child(3),
  .hp__statement .ln:nth-child(4) {
    color: var(--color-brand-blue);
  }
  .hp__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--color-brand-blue);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brand-blue);
    transition: gap 0.4s var(--ease-smooth);
  }
  .hp__cta:hover {
    gap: 1.5rem;
  }
  .hp__factory {
    position: relative;
    overflow: hidden;
    min-height: 40svh;
    background: #cfdde7;
  }
  .hp__factory img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 52%; /* frames the glazed fronts and the car park, not just the roofs */
  }
  .hp__stations {
    position: absolute;
    left: clamp(0.75rem, 2vw, 1.625rem);
    right: clamp(0.75rem, 2vw, 1.625rem);
    bottom: clamp(0.75rem, 2.4svh, 1.5rem);
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
    background: rgb(255 255 255 / 0.84);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-radius: 14px;
    box-shadow: 0 20px 50px -30px rgb(13 31 45 / 0.5);
  }
  .hp__stations li {
    padding: 0.95rem 1rem;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-brand-navy);
  }
  .hp__stations li + li {
    border-left: 1px solid rgb(11 43 64 / 0.1);
  }
  .hp__stations b {
    display: block;
    margin-bottom: 0.2rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-brand-blue);
  }
  @media (max-width: 860px) {
    .hp {
      min-height: 0;
    }
    .hp__factory {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }
    .hp__stations {
      position: relative;
      inset: auto;
      grid-template-columns: repeat(2, 1fr);
      margin: 0;
      border-radius: 0;
    }
    .hp__factory {
      display: grid;
      aspect-ratio: auto;
    }
    .hp__factory img {
      position: relative;
      height: auto;
      aspect-ratio: 2000 / 923;
    }
  }
</style>
