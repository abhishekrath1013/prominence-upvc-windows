---
// "A Window for Every Way of Living." — the frame collection. Where the aluminium site has a 3D configurator, this shows the
// real uPVC frames from the Prominance brochure (corner and cross sections of each system), one at a time, with what each is for.
// All eight frames and captions are in the HTML at once, so the content is crawlable and reads without JavaScript.
import { Image } from 'astro:assets';
import { frames, frameList } from '../../data/home';

const imgs = import.meta.glob('../../assets/images/brochure/profiles/*.png', { eager: true, import: 'default' }) as Record<string, any>;
const img = (n: string) => imgs[`../../assets/images/brochure/profiles/${n}.png`];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="fr" id="frames" data-fr aria-labelledby="fr-title">
  <div class="fr__box">
    <div class="fr__panel">
      <p class="fr__eyebrow" data-reveal="fade">{frames.eyebrow}</p>
      <h2 id="fr-title" class="fr__title" data-reveal="up">{frames.title}</h2>
      <p class="fr__intro" data-reveal="up">{frames.intro}</p>

      <ol class="fr__list" data-reveal="up" aria-label="Frames">
        {
          frameList.map((f, i) => (
            <li>
              <button type="button" data-fr-pick={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                <span>{pad(i + 1)}</span>
                <b>{f.name}</b>
                <em>{f.kind}</em>
              </button>
            </li>
          ))
        }
      </ol>

      <p class="fr__note" data-reveal="up">{frames.note}</p>
      <a class="fr__link" href={frames.finishes.href} data-reveal="up">
        {frames.finishes.label}
        <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" stroke="currentColor" stroke-width="1.2"></path></svg>
      </a>
    </div>

    <div class="fr__stage" data-fr-stage>
      <div class="fr__card">
        <span class="fr__ghost" aria-hidden="true" data-fr-ghost>01</span>
        <div class="fr__figs">
          {
            frameList.map((f, i) => (
              <figure class={`fr__fig${i === 0 ? ' is-on' : ''}`} data-fr-fig={i}>
                <Image src={img(f.img)} alt={f.alt} widths={[420, 640]} sizes="(max-width: 960px) 80vw, 34vw" loading={i === 0 ? 'eager' : 'lazy'} />
              </figure>
            ))
          }
        </div>
        <div class="fr__nav">
          <button type="button" class="fr__ico" data-fr-prev aria-label="Previous frame">
            <svg width="16" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M18 5H2M6 1L2 5l4 4" stroke="currentColor" stroke-width="1.2"></path></svg>
          </button>
          <p><b data-fr-count>01</b> / {pad(frameList.length)}</p>
          <button type="button" class="fr__ico" data-fr-next aria-label="Next frame">
            <svg width="16" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" stroke="currentColor" stroke-width="1.2"></path></svg>
          </button>
        </div>
      </div>

      <div class="fr__caps" aria-live="polite">
        {
          frameList.map((f, i) => (
            <div class="fr__cap" data-fr-cap={i} hidden={i !== 0}>
              <p class="fr__cap-k">{f.kind}</p>
              <h3>{f.name}<span>{f.tagline}</span></h3>
              <p class="fr__cap-t">{f.text}</p>
              <ul>{f.facts.map((t) => <li>{t}</li>)}</ul>
              <a href={f.href}>Explore {f.name} <i aria-hidden="true">→</i></a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style is:global>
  .fr {
    position: relative;
    background: #fff;
  }
  .fr__box {
    max-width: 1560px;
    margin-inline: auto;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(340px, 0.82fr) 1.35fr;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3.5rem);
    padding: clamp(4.5rem, 9svh, 6.5rem) clamp(1.25rem, 5vw, 5rem);
  }
  .fr__eyebrow {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-brand-green);
  }
  .fr__title {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 3.2vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    color: var(--color-brand-navy);
  }
  .fr__intro {
    margin-top: 1rem;
    max-width: 30rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgb(11 43 64 / 0.7);
  }
  .fr__list {
    margin: 1.8rem 0 0;
    padding: 0;
    list-style: none;
    max-width: 30rem;
    border-top: 1px solid rgb(11 43 64 / 0.12);
  }
  .fr__list li {
    border-bottom: 1px solid rgb(11 43 64 / 0.1);
  }
  .fr__list button {
    display: flex;
    width: 100%;
    align-items: baseline;
    gap: 1rem;
    padding: 0.72rem 0;
    text-align: left;
    color: rgb(11 43 64 / 0.6);
    transition: color 0.3s ease, padding 0.4s var(--ease-smooth);
  }
  .fr__list button:hover {
    color: var(--color-brand-navy);
    padding-left: 0.4rem;
  }
  .fr__list span {
    width: 1.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-brand-blue);
  }
  .fr__list b {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    letter-spacing: -0.02em;
  }
  .fr__list em {
    margin-left: auto;
    font-style: normal;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .fr__list button[aria-pressed='true'] {
    color: var(--color-brand-navy);
    padding-left: 0.6rem;
    box-shadow: inset 2px 0 0 var(--color-brand-green);
  }
  .fr__list button[aria-pressed='true'] b {
    color: var(--color-brand-blue);
  }
  .fr__note {
    margin-top: 1.4rem;
    max-width: 28rem;
    font-size: 0.75rem;
    line-height: 1.6;
    color: rgb(11 43 64 / 0.5);
  }
  .fr__link {
    margin-top: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-brand-blue);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brand-blue);
    transition: gap 0.4s var(--ease-smooth);
  }
  .fr__link:hover {
    gap: 1.5rem;
  }

  /* ---------- stage ---------- */
  .fr__stage {
    display: grid;
    gap: 1rem;
  }
  .fr__card {
    position: relative;
    height: clamp(400px, 56svh, 600px);
    border-radius: 24px;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 55% at 50% 52%, #fff 0%, rgb(255 255 255 / 0) 70%),
      linear-gradient(160deg, #e6eff5 0%, #d3e2ec 100%);
    box-shadow: 0 40px 80px -48px rgb(13 31 45 / 0.5), inset 0 0 0 1px rgb(13 31 45 / 0.06);
  }
  .fr__ghost {
    position: absolute;
    left: 2rem;
    bottom: -1.2rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(8rem, 18vw, 16rem);
    line-height: 1;
    letter-spacing: -0.06em;
    color: rgb(7 110 161 / 0.08);
    user-select: none;
  }
  .fr__figs {
    position: absolute;
    inset: clamp(1.5rem, 3vw, 2.5rem);
  }
  .fr__fig {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transform: translateY(18px) scale(0.96);
    transition: opacity 0.6s ease, transform 0.9s var(--ease-smooth);
    pointer-events: none;
  }
  .fr__fig.is-on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .fr__fig img {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    max-width: none;
    object-fit: contain !important;
    filter: drop-shadow(0 30px 28px rgb(13 31 45 / 0.25));
  }
  .fr__nav {
    position: absolute;
    right: 1.25rem;
    bottom: 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: rgb(11 43 64 / 0.55);
  }
  .fr__nav b {
    color: var(--color-brand-blue);
  }
  .fr__ico {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid rgb(11 43 64 / 0.25);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.7);
    color: var(--color-brand-navy);
    transition: background-color 0.35s ease, border-color 0.35s ease, color 0.35s ease;
  }
  .fr__ico:hover {
    background: var(--color-brand-blue);
    border-color: var(--color-brand-blue);
    color: #fff;
  }
  .fr__caps {
    display: grid;
    padding: 0.2rem 0.4rem 0;
  }
  .fr__cap {
    grid-area: 1 / 1;
    animation: fr-in 0.7s var(--ease-smooth) both;
  }
  .fr__cap[hidden] {
    display: none;
  }
  @keyframes fr-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  .fr__cap-k {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-brand-green);
  }
  .fr__cap h3 {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.4rem, 2vw, 1.9rem);
    letter-spacing: -0.035em;
    color: var(--color-brand-navy);
  }
  .fr__cap h3 span {
    margin-left: 0.9rem;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0;
    color: rgb(11 43 64 / 0.5);
  }
  .fr__cap-t {
    margin-top: 0.5rem;
    max-width: 44rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgb(11 43 64 / 0.8);
  }
  .fr__cap ul {
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .fr__cap li {
    padding: 0.35rem 0.75rem;
    border: 1px solid rgb(11 43 64 / 0.15);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    color: rgb(11 43 64 / 0.7);
  }
  .fr__cap a {
    display: inline-flex;
    gap: 0.6rem;
    margin-top: 0.9rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--color-brand-blue);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-blue);
  }
  .fr__cap a i {
    font-style: normal;
    transition: transform 0.3s ease;
  }
  .fr__cap a:hover i {
    transform: translateX(4px);
  }

  @media (max-width: 960px) {
    .fr__box {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 2rem;
      padding-top: 4.5rem;
      padding-bottom: 3.5rem;
    }
    .fr__card {
      height: min(70svh, 440px);
    }
    .fr__cap h3 span {
      display: block;
      margin: 0.2rem 0 0;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-fr]');
  if (root) {
    const figs = Array.from(root.querySelectorAll<HTMLElement>('[data-fr-fig]'));
    const caps = Array.from(root.querySelectorAll<HTMLElement>('[data-fr-cap]'));
    const picks = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-fr-pick]'));
    const count = root.querySelector<HTMLElement>('[data-fr-count]');
    const ghost = root.querySelector<HTMLElement>('[data-fr-ghost]');
    const n = figs.length;
    let i = 0;
    const show = (k: number) => {
      i = (k + n) % n;
      figs.forEach((f, j) => f.classList.toggle('is-on', j === i));
      caps.forEach((c, j) => (c.hidden = j !== i));
      picks.forEach((p, j) => p.setAttribute('aria-pressed', String(j === i)));
      const label = String(i + 1).padStart(2, '0');
      if (count) count.textContent = label;
      if (ghost) ghost.textContent = label;
    };
    picks.forEach((p, j) => p.addEventListener('click', () => show(j)));
    root.querySelector('[data-fr-prev]')?.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-fr-next]')?.addEventListener('click', () => show(i + 1));
  }
</script>
