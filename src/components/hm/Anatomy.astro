---
// "Every Component Has a Purpose." — the aluminium "Inside the frame" section, redrawn in 2D.
// Idle: a front-elevation drawing of the window stands centred, numbered pins on it, the six components listed on the right.
// "View components" slides the drawing left and opens the panel: the brochure's close-up of the part, what it is for, and
// the proof detail. Every description is also plain text in the page.
import { Image } from 'astro:assets';
import windowImg from '../../assets/images/brochure/profiles/inventa-casement.png';
import { anatomy, components } from '../../data/home';

const imgs = import.meta.glob('../../assets/images/real/diagrams/*.jpg', { eager: true, import: 'default' }) as Record<string, any>;
const img = (n: string) => imgs[`../../assets/images/real/diagrams/${n}.jpg`];
const pad = (n: number) => String(n).padStart(2, '0');
// pin positions as % of the photograph: profile, steel, lock, gasket, drain, weld
const pins = [
  { x: 12.5, y: 71 },
  { x: 16.5, y: 88 },
  { x: 71, y: 30 },
  { x: 49, y: 37 },
  { x: 40, y: 79 },
  { x: 64, y: 66 },
];
---

<section class="cx" id="components" data-cx data-state="idle" aria-labelledby="cx-title">
  <div class="cx__bg" aria-hidden="true"></div>

  <!-- the drawing: centred while idle, left half once opened -->
  <figure class="cx__fig" data-cx-fig>
    <div class="cx__draw">
      <Image src={windowImg} alt="Cut-away corner of a Prominance uPVC casement window: multi-chambered profile, red steel reinforcement, glazing gasket and welded corner" class="cx__window" widths={[480, 820]} sizes="(max-width: 1023px) 80vw, 40vw" loading="lazy" />
      <span class="cx__shadow" aria-hidden="true"></span>

      {
        components.map((c, i) => (
          <button type="button" class="cx__pin" data-cx-pick={i} disabled aria-label={`View ${c.name}`} style={`left:${pins[i].x}%;top:${pins[i].y}%`}>
            <span>{pad(i + 1)}</span>
          </button>
        ))
      }
    </div>
  </figure>

  <!-- ===== idle ===== -->
  <div class="cx__intro">
    <div class="cx__intro-grid">
      <div class="cx__copy">
        <p class="cx__eyebrow">{anatomy.eyebrow}</p>
        <h2 id="cx-title" class="cx__title">{anatomy.title}</h2>
        <p class="cx__lede">{anatomy.intro}</p>
      </div>

      <ol class="cx__index">
        {
          components.map((c, i) => (
            <li>
              <button type="button" data-cx-pick={i} disabled aria-label={`View ${c.name}`}>
                <span>{pad(i + 1)}</span>
                {c.name}
              </button>
            </li>
          ))
        }
      </ol>

      <div class="cx__cta">
        <button type="button" class="cx__open" data-cx-open disabled>
          <span>View components</span>
          <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" stroke="currentColor" stroke-width="1"></path></svg>
        </button>
        <p class="cx__hint">{anatomy.hint}</p>
      </div>
    </div>
  </div>

  <!-- ===== opened ===== -->
  <div class="cx__panel" aria-live="polite">
    <div class="cx__panel-in">
      <div class="cx__bar">
        <button type="button" class="cx__back" data-cx-close>
          <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M18 5H2M6 1L2 5l4 4" stroke="currentColor" stroke-width="1"></path></svg>
          <span>Full window</span>
        </button>
        <div class="cx__pager">
          <p><b data-cx-count>01</b> / {pad(components.length)}</p>
          <button type="button" class="cx__ico" data-cx-prev aria-label="Previous component">
            <svg width="16" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M18 5H2M6 1L2 5l4 4" stroke="currentColor" stroke-width="1.2"></path></svg>
          </button>
          <button type="button" class="cx__ico" data-cx-next aria-label="Next component">
            <svg width="16" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 5h16M12 1l4 4-4 4" stroke="currentColor" stroke-width="1.2"></path></svg>
          </button>
        </div>
      </div>

      <div class="cx__items">
        {
          components.map((c, i) => (
            <article class="cx__item" data-cx-item={i} hidden={i !== 0}>
              <div class="cx__itemtext">
                <p class="cx__kicker">{c.kicker}</p>
                <h3 class="cx__name">{c.name}</h3>
                <p class="cx__desc">{c.blurb}</p>
                <p class="cx__proof"><span>Proof</span>{c.detail}</p>
              </div>
              <div class="cx__photo">
                <Image src={img(c.image)} alt={c.alt} widths={[420, 640]} sizes="(max-width: 1023px) 70vw, 30vw" loading="lazy" />
              </div>
            </article>
          ))
        }
      </div>

      <nav class="cx__chips" aria-label="Components">
        {
          components.map((c, i) => (
            <button type="button" class="cx__chip" data-cx-chip={i} aria-label={c.name} title={c.name} aria-current={i === 0 ? 'true' : 'false'}>
              {pad(i + 1)}
            </button>
          ))
        }
      </nav>
    </div>
  </div>

  <p class="sr-only">{anatomy.quote}</p>
</section>

<style is:global>
  .cx {
    --cx-ease: var(--ease-smooth);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #fff;
    height: 100svh;
    min-height: 640px;
  }
  .cx__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse 34% 62% at 50% 52%, rgb(7 110 161 / 0.1), transparent 70%),
      radial-gradient(ellipse 60% 26% at 50% 96%, rgb(66 155 70 / 0.08), transparent 70%),
      linear-gradient(180deg, #fff 0%, #f4f8fb 55%, #fff 100%);
    transition: opacity 1s ease;
  }

  /* ---------- the drawing ---------- */
  .cx__fig {
    position: absolute;
    z-index: 2;
    top: 15%;
    bottom: 21%;
    left: 50%;
    translate: -50% 0;
    aspect-ratio: 1;
    margin: 0;
    transition: left 1.05s var(--cx-ease), top 1.05s var(--cx-ease), bottom 1.05s var(--cx-ease);
  }
  .cx[data-state='open'] .cx__fig {
    left: 25%;
    top: 16%;
    bottom: 14%;
  }
  .cx__draw {
    position: relative;
    height: 100%;
    aspect-ratio: 1;
  }
  .cx__window {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 30px 30px rgb(13 31 45 / 0.22));
  }
  .cx__shadow {
    position: absolute;
    left: 14%;
    right: 6%;
    bottom: -3%;
    height: 5%;
    border-radius: 50%;
    background: rgb(13 31 45 / 0.12);
    filter: blur(8px);
  }
  .cx__pin {
    position: absolute;
    z-index: 2;
    translate: -50% -50%;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--color-brand-blue);
    color: #fff;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    box-shadow: 0 0 0 4px rgb(255 255 255 / 0.9), 0 8px 18px -6px rgb(7 110 161 / 0.7);
    transition: transform 0.4s var(--cx-ease), background-color 0.3s ease, opacity 0.4s ease;
  }
  .cx__pin::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 999px;
    border: 1px solid rgb(7 110 161 / 0.7);
    animation: cx-pulse 2.4s var(--cx-ease) infinite;
  }
  .cx__pin:not(:disabled):hover {
    transform: scale(1.12);
  }
  .cx__pin:disabled {
    cursor: progress;
  }
  .cx[data-state='open'] .cx__pin {
    opacity: 0.45;
    background: var(--color-brand-navy);
  }
  .cx[data-state='open'] .cx__pin.is-on {
    opacity: 1;
    background: var(--color-brand-green);
    transform: scale(1.14);
  }
  @keyframes cx-pulse {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  /* ---------- idle copy ---------- */
  .cx__intro {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    transition: opacity 0.7s ease, visibility 0.7s;
  }
  .cx[data-state='open'] .cx__intro {
    opacity: 0;
    visibility: hidden;
  }
  .cx__intro-grid {
    position: relative;
    max-width: 1560px;
    margin-inline: auto;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: 1fr auto;
    align-items: center;
    padding: clamp(96px, 12svh, 132px) clamp(1.25rem, 5vw, 5rem) clamp(28px, 5svh, 56px);
  }
  .cx__copy {
    grid-column: 1;
    grid-row: 1;
    max-width: 21rem;
  }
  .cx__eyebrow {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--color-brand-green);
  }
  .cx__title {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 3.1vw, 3.1rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: var(--color-brand-navy);
  }
  .cx__lede {
    margin-top: 1.2rem;
    font-size: 0.92rem;
    line-height: 1.65;
    color: rgb(11 43 64 / 0.68);
  }
  .cx__index {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.85rem;
    letter-spacing: 0.01em;
    color: rgb(11 43 64 / 0.6);
  }
  .cx__index li {
    border-bottom: 1px solid rgb(11 43 64 / 0.1);
    min-width: 16rem;
  }
  .cx__index button {
    display: flex;
    width: 100%;
    gap: 1rem;
    align-items: baseline;
    padding: 0.3rem 0 0.6rem;
    text-align: left;
    color: inherit;
    cursor: pointer;
    pointer-events: auto;
    transition: color 0.3s ease, transform 0.4s var(--cx-ease);
  }
  .cx__index button:hover,
  .cx__index button:focus-visible {
    color: var(--color-brand-navy);
    transform: translateX(-4px);
  }
  .cx__index button:disabled {
    cursor: progress;
  }
  .cx__index span {
    width: 1.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-brand-blue);
  }
  .cx__cta {
    grid-column: 1 / -1;
    grid-row: 2;
    justify-self: center;
    text-align: center;
    pointer-events: auto;
  }
  .cx__open {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.05rem 2rem;
    border: 1px solid var(--color-brand-navy);
    border-radius: 999px;
    background: var(--color-brand-navy);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #fff;
    transition: background-color 0.4s ease, border-color 0.4s ease, opacity 0.4s ease;
  }
  .cx__open:hover {
    background: var(--color-brand-blue);
    border-color: var(--color-brand-blue);
  }
  .cx__open:disabled {
    opacity: 0.45;
    cursor: progress;
  }
  .cx__hint {
    margin-top: 1rem;
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(11 43 64 / 0.4);
  }

  /* ---------- opened panel ---------- */
  .cx__panel {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    right: 0;
    z-index: 3;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.5s ease, visibility 0.5s;
  }
  .cx[data-state='open'] .cx__panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.9s ease 0.55s, visibility 0s 0.55s;
  }
  .cx__panel-in {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(92px, 11svh, 124px) clamp(1.25rem, 5vw, 5rem) clamp(24px, 4svh, 44px) clamp(1rem, 3vw, 3.5rem);
    border-left: 1px solid rgb(11 43 64 / 0.1);
  }
  .cx__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgb(11 43 64 / 0.12);
  }
  .cx__back {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(11 43 64 / 0.65);
    transition: color 0.3s ease;
  }
  .cx__back:hover {
    color: var(--color-brand-blue);
  }
  .cx__pager {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: rgb(11 43 64 / 0.55);
  }
  .cx__pager b {
    color: var(--color-brand-blue);
  }
  .cx__ico {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid rgb(11 43 64 / 0.25);
    border-radius: 999px;
    color: var(--color-brand-navy);
    transition: background-color 0.35s ease, border-color 0.35s ease, color 0.35s ease;
  }
  .cx__ico:hover {
    background: var(--color-brand-blue);
    border-color: var(--color-brand-blue);
    color: #fff;
  }
  /* every component is stacked in one grid cell, so the panel is as tall as the longest and nothing jumps */
  .cx__items {
    flex: 1 1 0;
    display: grid;
    align-items: center;
    min-height: 0;
  }
  .cx__item {
    grid-area: 1 / 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(1.25rem, 3vw, 3rem);
    animation: cx-in 0.8s var(--cx-ease) both;
  }
  .cx__item[hidden] {
    display: none;
  }
  @keyframes cx-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  .cx__kicker {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-brand-green);
  }
  .cx__name {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.9rem, 3vw, 3.1rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: var(--color-brand-navy);
  }
  .cx__desc {
    margin-top: 1.1rem;
    font-size: clamp(1.05rem, 1.45vw, 1.35rem);
    line-height: 1.4;
    font-weight: 400;
    color: rgb(11 43 64 / 0.88);
  }
  .cx__proof {
    margin-top: 1.3rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(11 43 64 / 0.12);
    font-size: 0.9rem;
    line-height: 1.6;
    font-weight: 500;
    color: rgb(11 43 64 / 0.7);
  }
  .cx__proof span {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-brand-blue);
  }
  .cx__photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 999px;
    box-shadow: 0 30px 50px -30px rgb(13 31 45 / 0.4);
  }
  .cx__chips {
    padding-top: clamp(0.8rem, 2svh, 1.4rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .cx__chip {
    min-width: 2.5rem;
    height: 2.1rem;
    padding: 0 0.7rem;
    border: 1px solid rgb(11 43 64 / 0.22);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: rgb(11 43 64 / 0.6);
    transition: all 0.35s ease;
  }
  .cx__chip:hover {
    border-color: var(--color-brand-blue);
    color: var(--color-brand-blue);
  }
  .cx__chip[aria-current='true'] {
    background: var(--color-brand-blue);
    border-color: var(--color-brand-blue);
    color: #fff;
  }

  /* ---------- tablet / phone: drawing on top, panel below ---------- */
  @media (max-width: 1023px) {
    .cx {
      height: auto;
      min-height: 0;
    }
    .cx__fig,
    .cx[data-state='open'] .cx__fig {
      position: relative;
      left: auto;
      translate: none;
      top: auto;
      bottom: auto;
      height: clamp(320px, 46svh, 440px);
      margin: 0 auto;
      transition: none;
    }
    .cx__intro,
    .cx__panel {
      position: relative;
      inset: auto;
    }
    .cx__intro-grid {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.6rem;
      padding: 4.5rem 1.25rem 2.5rem;
    }
    .cx {
      display: flex;
      flex-direction: column-reverse;
    }
    .cx__index {
      display: none;
    }
    .cx__cta {
      justify-self: auto;
      text-align: left;
    }
    .cx[data-state='open'] .cx__intro {
      display: none;
    }
    .cx__panel {
      display: none;
      opacity: 1;
      visibility: visible;
    }
    .cx[data-state='open'] .cx__panel {
      display: block;
    }
    .cx__panel-in {
      padding: 1.25rem 1.25rem 2.5rem;
      border-left: 0;
    }
    .cx__item {
      grid-template-columns: 1fr;
    }
    .cx__photo {
      max-width: 18rem;
      order: -1;
    }
  }
</style>

<script>
  import { components } from '../../data/home';

  const root = document.querySelector<HTMLElement>('[data-cx]');
  if (root) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-cx-item]'));
    const chips = Array.from(root.querySelectorAll<HTMLElement>('[data-cx-chip]'));
    const pins = Array.from(root.querySelectorAll<HTMLButtonElement>('.cx__pin'));
    const count = root.querySelector<HTMLElement>('[data-cx-count]');
    const n = components.length;
    let i = 0;

    const show = (k: number) => {
      i = (k + n) % n;
      items.forEach((el) => (el.hidden = Number(el.dataset.cxItem) !== i));
      chips.forEach((c, j) => c.setAttribute('aria-current', String(j === i)));
      pins.forEach((p, j) => p.classList.toggle('is-on', j === i));
      if (count) count.textContent = String(i + 1).padStart(2, '0');
    };
    const openAt = (k: number) => {
      root.dataset.state = 'open';
      show(k);
    };

    // the buttons are rendered disabled for crawlers/no-JS; enable them once this script runs
    root.querySelectorAll<HTMLButtonElement>('button[disabled]').forEach((b) => (b.disabled = false));
    root.querySelector('[data-cx-open]')?.addEventListener('click', () => openAt(0));
    root.querySelectorAll<HTMLElement>('[data-cx-pick]').forEach((b) => b.addEventListener('click', () => openAt(Number(b.dataset.cxPick))));
    root.querySelector('[data-cx-close]')?.addEventListener('click', () => (root.dataset.state = 'idle'));
    root.querySelector('[data-cx-prev]')?.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-cx-next]')?.addEventListener('click', () => show(i + 1));
    chips.forEach((c, j) => c.addEventListener('click', () => show(j)));
    document.addEventListener('keydown', (e) => {
      if (root.dataset.state !== 'open') return;
      if (e.key === 'ArrowRight') show(i + 1);
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'Escape') root.dataset.state = 'idle';
    });
    show(0);
  }
</script>
