---
import { Image } from 'astro:assets';
import logo from '../../assets/images/real/brand/logo.png';
import { brand, contact, sampleCities } from '../../data/brand';

const currentYear = new Date().getFullYear();

const columns = [
  {
    title: 'Windows',
    links: [
      { href: '/windows/casement/', label: 'Casement Windows' },
      { href: '/windows/sliding/', label: 'Sliding Windows' },
      { href: '/windows/tilt-turn/', label: 'Tilt & Turn Windows' },
      { href: '/colours/', label: 'Colour Options' },
    ],
  },
  {
    title: 'Doors',
    links: [
      { href: '/doors/casement/', label: 'Casement Doors' },
      { href: '/doors/sliding/', label: 'Sliding Doors' },
      { href: '/doors/slide-fold/', label: 'Slide & Fold Doors' },
      { href: '/compare/', label: 'Compare Products' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/why-prominance/', label: 'Why Prominance' },
      { href: '/why-prominance/infrastructure/', label: 'Infrastructure' },
      { href: '/why-prominance/quality-standards/', label: 'Quality Standards' },
      { href: '/projects/', label: 'Projects' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: '/resources/faqs/', label: 'FAQs' },
      { href: '/resources/downloads/', label: 'Downloads' },
      { href: '/quote/', label: 'Get a Quote' },
      { href: '/contact/', label: 'Contact Us' },
    ],
  },
];

const socialLinks = [
  { href: contact.social.facebook, label: 'Facebook' },
  { href: contact.social.instagram, label: 'Instagram' },
  { href: contact.social.linkedin, label: 'LinkedIn' },
  { href: contact.social.youtube, label: 'YouTube' },
];
---

<footer class="border-t border-border bg-neutral-900 text-neutral-300">
  <div class="container-prom grid grid-cols-2 gap-x-8 gap-y-12 py-16 md:grid-cols-6">
    <div class="col-span-2 flex flex-col gap-5">
      <Image src={logo} alt="Prominance" height={36} width={136} class="brightness-0 invert" />
      <p class="max-w-xs text-sm leading-relaxed text-neutral-400">{brand.tagline}</p>
      <div class="flex flex-col gap-1 text-sm text-neutral-400">
        <a href={contact.tollFreeHref} class="font-bold text-white hover:text-accent-400">{contact.tollFree} (Toll Free)</a>
        <a href={contact.phoneHref} class="hover:text-white">{contact.phone}</a>
        <a href={`mailto:${contact.email}`} class="hover:text-white">{contact.email}</a>
      </div>
      <div class="flex gap-3 pt-2">
        {socialLinks.map((s) => (
          <a href={s.href} aria-label={s.label} class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-xs font-bold hover:bg-accent-600 hover:text-white">
            {s.label[0]}
          </a>
        ))}
      </div>
    </div>

    {columns.map((col) => (
      <div class="flex flex-col gap-3">
        <h3 class="text-sm font-bold uppercase tracking-wide text-white">{col.title}</h3>
        <ul class="flex flex-col gap-2.5">
          {col.links.map((l) => (
            <li><a href={l.href} class="text-sm text-neutral-400 hover:text-white">{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="border-t border-white/10">
    <div class="container-prom flex flex-col gap-3 py-6">
      <span class="text-xs font-bold uppercase tracking-wide text-neutral-500">Also serving</span>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        {sampleCities.map((c) => (
          <a href={`/locations/${c.slug}/`} class="text-sm text-neutral-400 hover:text-white">{c.name}</a>
        ))}
        <span class="text-sm text-neutral-600">+ 15 more cities across India</span>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-prom flex flex-col items-center justify-between gap-3 py-6 text-xs text-neutral-500 sm:flex-row">
      <span>© {currentYear} {brand.legalName}. All rights reserved.</span>
      <div class="flex gap-5">
        <a href="/privacy/" class="hover:text-white">Privacy Policy</a>
        <a href="/terms/" class="hover:text-white">Terms & Conditions</a>
      </div>
    </div>
  </div>
</footer>
