---
import { contact } from '../../data/brand';
---

<div class="fixed inset-x-0 bottom-0 z-40 flex gap-2 border-t border-ink/10 bg-bone/90 p-3 backdrop-blur-xl lg:hidden" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
  <a
    href={contact.tollFreeHref}
    class="flex flex-1 items-center justify-center gap-2 rounded-full border border-ink/30 py-3.5 text-[0.66rem] font-medium uppercase tracking-[0.2em] text-ink"
  >
    <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M3 2.5h2.5l1 3.5-1.5 1a8 8 0 0 0 4 4l1-1.5 3.5 1V13c0 .55-.45 1-1 1C6.5 14 2 9.5 2 3.5c0-.55.45-1 1-1Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
    </svg>
    Call Now
  </a>
  <a
    href="/quote/"
    class="flex flex-1 items-center justify-center gap-2 rounded-full bg-ink py-3.5 text-[0.66rem] font-medium uppercase tracking-[0.2em] text-bone"
  >
    Get a Quote
  </a>
</div>
