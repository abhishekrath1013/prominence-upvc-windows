---
// Custom cursor: the Prominance "A" mark, tilted left like a native arrow.
import mark from '../../assets/prominance-a-mark.png';
---

<div class="uf-cursor" aria-hidden="true" data-uf-cursor data-src={mark.src}></div>

<style is:global>
  :root {
    --ease-precise: cubic-bezier(0.16, 1, 0.3, 1);
    --duration-micro: 320ms;
  }

  /* Hide the native cursor while the custom one is active */
  html.uf-custom-cursor,
  html.uf-custom-cursor * {
    cursor: none !important;
  }
  /* Keep the system cursor where a custom one would get in the way */
  html.uf-custom-cursor input,
  html.uf-custom-cursor textarea,
  html.uf-custom-cursor select,
  html.uf-custom-cursor dialog,
  html.uf-custom-cursor dialog * {
    cursor: auto !important;
  }
  html.uf-custom-cursor input[type='text'],
  html.uf-custom-cursor input[type='email'],
  html.uf-custom-cursor input[type='tel'],
  html.uf-custom-cursor textarea {
    cursor: text !important;
  }

  .uf-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 20px;
    height: 18px;
    margin-left: -2px;
    margin-top: -1px;
    background-repeat: no-repeat;
    background-position: center;
    background-size: contain;
    transform-origin: 10% 6%;
    filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.35));
    pointer-events: none;
    z-index: 9999;
    opacity: 0;
    transition:
      opacity var(--duration-micro) ease,
      width var(--duration-micro) var(--ease-precise),
      height var(--duration-micro) var(--ease-precise),
      margin var(--duration-micro) var(--ease-precise);
  }

  .uf-cursor.is-visible {
    opacity: 0.9;
  }

  .uf-cursor.is-hovering {
    width: 34px;
    height: 31px;
    margin-left: -3px;
    margin-top: -2px;
    opacity: 1;
  }

  .uf-cursor.is-native {
    opacity: 0;
  }

  @media (hover: none), (pointer: coarse) {
    .uf-cursor {
      display: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isFinePointer = window.matchMedia('(pointer: fine)').matches;
  const cursor = document.querySelector<HTMLElement>('[data-uf-cursor]');

  if (!reduceMotion && isFinePointer && cursor) {
    document.documentElement.classList.add('uf-custom-cursor');
    cursor.style.backgroundImage = `url("${cursor.dataset.src}")`;

    const pos = { x: window.innerWidth / 2, y: window.innerHeight / 2 };
    const target = { x: pos.x, y: pos.y };
    let tiltDeg = -22; // tilts left like a native arrow

    // Elements that enlarge the cursor: anything marked data-cursor-hover, plus links and controls.
    const hoverSel =
      '[data-cursor-hover], a[href], button, summary, label, [role="button"], [role="tab"], [role="radio"]';
    const nativeSel = 'input, textarea, select, dialog, [contenteditable="true"]';

    window.addEventListener('mousemove', (e) => {
      target.x = e.clientX;
      target.y = e.clientY;
      cursor.classList.add('is-visible');

      const t = e.target as Element | null;
      const hovering = !!t?.closest(hoverSel);
      cursor.classList.toggle('is-hovering', hovering);
      cursor.classList.toggle('is-native', !!t?.closest(nativeSel));
      tiltDeg = hovering ? -14 : -22;
    });

    (function tick() {
      pos.x += (target.x - pos.x) * 0.18; // lower = floatier
      pos.y += (target.y - pos.y) * 0.18;
      cursor.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0) rotate(${tiltDeg}deg)`;
      requestAnimationFrame(tick);
    })();

    document.addEventListener('mouseleave', () => cursor.classList.remove('is-visible'));
  }
</script>
