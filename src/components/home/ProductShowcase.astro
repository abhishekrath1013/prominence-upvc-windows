---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { resolveImage } from '../../data/images';

interface Props {
  category: 'window' | 'door';
  hideViewAll?: boolean;
}
const { category, hideViewAll = false } = Astro.props;

const all = await getCollection('products', (p) => p.data.category === category);
const order = category === 'window' ? ['casement', 'sliding', 'tilt-turn'] : ['casement', 'sliding', 'slide-fold'];
const products = order.map((style) => all.find((p) => p.data.style === style)!).filter(Boolean);

const basePath = category === 'window' ? '/windows' : '/doors';
const copy =
  category === 'window'
    ? {
        eyebrow: 'Windows',
        heading: 'Find your perfect window.',
        description: 'Three window styles, each built for a different way of living.',
      }
    : {
        eyebrow: 'Doors',
        heading: 'Doors that open your home outward.',
        description: 'From weatherproof entries to full walls that fold away.',
      };
---

<section class="py-20 sm:py-28">
  <div class="container-prom flex flex-col gap-12">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <SectionHeading eyebrow={copy.eyebrow} heading={copy.heading} description={copy.description} />
      {!hideViewAll && (
        <Button href={`${basePath}/`} variant="ghost" class="shrink-0">View all {category === 'window' ? 'windows' : 'doors'}</Button>
      )}
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p, i) => (
        <a
          href={`${basePath}/${p.data.style}/`}
          class="reveal group flex flex-col overflow-hidden rounded-2xl bg-white shadow-[var(--shadow-card)] transition-shadow duration-300 hover:shadow-[var(--shadow-card-hover)]"
          data-reveal-delay={i * 90}
        >
          <div class="aspect-[4/3] overflow-hidden bg-neutral-100">
            <Image
              src={resolveImage(p.data.heroImage)}
              alt={p.data.title}
              class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
              widths={[400, 600]}
              sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
            />
          </div>
          <div class="flex flex-1 flex-col gap-3 p-6">
            <h3 class="text-xl font-bold text-ink">{p.data.shortName}</h3>
            <p class="flex-1 text-[15px] leading-relaxed text-ink-muted">{p.data.whyChooseIt}</p>
            <span class="flex items-center gap-1.5 text-sm font-bold text-primary-700">
              Explore
              <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
