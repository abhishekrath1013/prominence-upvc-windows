---

const items = [
  { to: 20, suffix: '', unit: 'years', label: 'Colour warranty on laminated finishes' },
  { to: 25000, suffix: '+', unit: 'hours', label: 'Accelerated weather testing' },
  { to: 22000, suffix: '', unit: 'MT / year', label: 'In-house extrusion capacity' },
  { to: 30, suffix: '%', unit: '', label: 'Typical reduction in energy loss' },
];
---

<section id="trust" class="relative z-20 -mt-14 pb-6 sm:-mt-16">
  <div class="container-prom">
    <div class="reveal overflow-hidden rounded-3xl border border-border bg-white shadow-[var(--shadow-pop)]" data-reveal="scale">
      <div class="brand-bar h-1.5 w-full"></div>
      <div class="grid grid-cols-2 lg:grid-cols-4">
        {items.map((it, i) => (
          <div class={`flex flex-col gap-1 border-border p-6 sm:p-8 ${i < 2 ? 'border-b lg:border-b-0' : ''} ${i % 2 === 0 ? 'border-r' : ''} ${i === 1 ? 'lg:border-r' : ''}`}>
            <div class="flex items-baseline gap-1.5">
              <span class="text-4xl font-extrabold tracking-tight text-primary-700 sm:text-5xl" data-count-to={it.to} data-count-suffix={it.suffix}>0</span>
              {it.unit && <span class="text-sm font-bold text-accent-700">{it.unit}</span>}
            </div>
            <span class="text-sm leading-snug text-ink-muted">{it.label}</span>
          </div>
        ))}
      </div>
      <div class="flex flex-col items-center justify-between gap-4 border-t border-border bg-surface-alt px-6 py-5 sm:flex-row sm:px-8">
        <span class="text-xs font-bold uppercase tracking-[0.14em] text-ink-muted">Independently tested &amp; certified</span>
        <ul class="flex flex-wrap justify-center gap-2 sm:justify-end">
          {['SKZ · Germany', 'BSI · UK', 'SGS', 'CIPET', 'EN 12608-1:2016'].map((b) => (
            <li class="rounded-full border border-border bg-white px-3.5 py-1.5 text-xs font-bold text-ink">{b}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
