---
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';

const windows = await getCollection('products', (p) => p.data.category === 'window');
const order = ['casement', 'sliding', 'tilt-turn'];
const products = order.map((s) => windows.find((p) => p.data.style === s)!).filter(Boolean);

const traits: { key: keyof typeof products[0]['data']['comparisonTraits']; label: string }[] = [
  { key: 'spaceSaving', label: 'Space saving' },
  { key: 'ventilation', label: 'Ventilation control' },
  { key: 'largeOpenings', label: 'Large openings' },
  { key: 'weatherSealing', label: 'Tightest weather seal' },
];
---

<section class="py-20 sm:py-28">
  <div class="container-prom flex flex-col gap-10">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <SectionHeading
        eyebrow="Which window is right for you?"
        heading="Compare without needing an expert."
        description="Every style is built to the same quality standard — the difference is how they open."
      />
      <Button href="/compare/" variant="ghost" class="shrink-0">Full comparison</Button>
    </div>

    <div class="reveal overflow-x-auto rounded-2xl border border-border bg-white">
      <table class="w-full min-w-[520px] border-collapse text-left">
        <thead>
          <tr class="border-b border-border">
            <th class="p-4 text-sm font-bold text-ink-muted">&nbsp;</th>
            {products.map((p) => (
              <th class="p-4 text-center text-base font-bold text-ink">{p.data.shortName}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {traits.map((t, i) => (
            <tr class={i % 2 === 0 ? 'bg-surface-alt/60' : ''}>
              <td class="p-4 text-sm font-semibold text-ink">{t.label}</td>
              {products.map((p) => (
                <td class="p-4 text-center">
                  {p.data.comparisonTraits[t.key] ? (
                    <svg class="mx-auto h-5 w-5 text-accent-600" viewBox="0 0 16 16" fill="none" aria-label="Yes"><path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  ) : (
                    <span class="mx-auto block h-1 w-3 rounded-full bg-border" aria-label="No"></span>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
