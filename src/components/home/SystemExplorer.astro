---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '../ui/SectionHeading.astro';

import casementLife from '../../assets/images/brochure/photos/inventa-casement-life.jpg';
import slidingLife from '../../assets/images/brochure/photos/inventa-sliding-life.jpg';
import tiltLife from '../../assets/images/brochure/photos/tilt-turn-life.jpg';
import doorCasementLife from '../../assets/images/brochure/photos/door-casement-life.jpg';
import doorSlidingLife from '../../assets/images/brochure/photos/door-sliding-life.jpg';
import bifoldLife from '../../assets/images/brochure/photos/bifold-life.jpg';
import casementProfile from '../../assets/images/brochure/profiles/inventa-casement.png';
import slidingProfile from '../../assets/images/brochure/profiles/inventa-sliding.png';
import tiltProfile from '../../assets/images/brochure/profiles/tilt-turn-3g.png';
import doorCasementProfile from '../../assets/images/brochure/profiles/door-casement.png';
import doorSlidingProfile from '../../assets/images/brochure/profiles/door-sliding.png';

const visuals: Record<string, { photo: ImageMetadata; profile?: ImageMetadata }> = {
  'windows/casement': { photo: casementLife, profile: casementProfile },
  'windows/sliding': { photo: slidingLife, profile: slidingProfile },
  'windows/tilt-turn': { photo: tiltLife, profile: tiltProfile },
  'doors/casement': { photo: doorCasementLife, profile: doorCasementProfile },
  'doors/sliding': { photo: doorSlidingLife, profile: doorSlidingProfile },
  'doors/slide-fold': { photo: bifoldLife },
};
const order = Object.keys(visuals);

const all = await getCollection('products');
const systems = order
  .map((id) => all.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
---

<section id="systems" class="py-20 sm:py-28" data-system-explorer>
  <div class="container-prom flex flex-col gap-12">
    <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end">
      <SectionHeading
        eyebrow="Windows and doors"
        heading="Six systems. One standard of build."
        description="Every Prominance system shares the same multi-chambered profile, steel core and fusion-welded corners — pick the way you want yours to open."
      />
      <a href="/compare/" class="reveal group inline-flex items-center gap-2 text-sm font-bold text-primary-700">
        Compare all styles side by side
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[260px_minmax(0,1fr)] lg:gap-12">
      <div class="reveal -mx-5 flex gap-2 overflow-x-auto px-5 pb-2 no-scrollbar lg:mx-0 lg:flex-col lg:gap-1 lg:overflow-visible lg:px-0" role="tablist" aria-label="Window and door systems" aria-orientation="vertical">
        {systems.map((s, i) => (
          <>
            {(i === 0 || i === 3) && (
              <span class="hidden px-4 pb-1 pt-2 text-[11px] font-bold uppercase tracking-[0.16em] text-ink-muted first:pt-0 lg:block">{i === 0 ? 'Windows' : 'Doors'}</span>
            )}
            <button
              type="button"
              role="tab"
              id={`sys-tab-${s.id.replace('/', '-')}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`sys-panel-${s.id.replace('/', '-')}`}
              tabindex={i === 0 ? 0 : -1}
              data-sys-tab={s.id}
              class="group relative flex shrink-0 items-center gap-3 whitespace-nowrap rounded-full border border-border px-5 py-3 text-left text-sm font-bold text-ink-muted transition-all duration-300 hover:border-primary-300 hover:text-ink aria-selected:border-primary-700 aria-selected:bg-primary-700 aria-selected:text-white lg:rounded-2xl lg:border-transparent lg:py-3.5 lg:aria-selected:shadow-[var(--shadow-pop)]"
            >
              <span class="hidden h-2 w-2 rounded-full bg-border transition-colors group-aria-selected:bg-accent-300 lg:block"></span>
              <span class="lg:hidden">{s.data.category === 'window' ? 'Window · ' : 'Door · '}</span>{s.data.shortName}
              <span class="ml-auto hidden text-xs font-semibold opacity-60 lg:block">{s.data.category === 'window' ? 'Window' : 'Door'}</span>
            </button>
          </>
        ))}
      </div>

      <div class="stack reveal min-w-0" data-reveal="right">
        {systems.map((s, i) => {
          const v = visuals[s.id];
          const slug = s.id.replace('/', '-');
          return (
            <article
              role="tabpanel"
              id={`sys-panel-${slug}`}
              aria-labelledby={`sys-tab-${slug}`}
              class={`fade-panel min-w-0 ${i === 0 ? 'is-active' : ''}`}
              data-sys-panel={s.id}
            >
              <div class="relative">
                <div class="relative aspect-[4/3] overflow-hidden rounded-3xl bg-neutral-100 sm:aspect-[16/10]">
                  <Image src={v.photo} alt={`${s.data.title} installed in a home`} class="h-full w-full object-cover" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 60vw, 100vw" loading={i === 0 ? 'eager' : 'lazy'} />
                  <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/40 via-transparent to-transparent"></div>
                  <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3.5 py-1.5 text-xs font-bold uppercase tracking-wide text-primary-800 backdrop-blur">{s.data.category === 'window' ? 'Window system' : 'Door system'}</span>
                </div>
                {v.profile && (
                  <div class="absolute -bottom-6 right-4 w-28 rounded-2xl bg-white p-2 shadow-[var(--shadow-pop)] sm:right-8 sm:w-40 sm:p-3" data-tilt="10">
                    <Image src={v.profile} alt={`${s.data.shortName} profile cross-section with steel reinforcement`} class="h-auto w-full" widths={[240, 360]} sizes="160px" />
                    <span class="mt-1 block text-center text-[10px] font-bold uppercase tracking-wide text-ink-muted">Profile section</span>
                  </div>
                )}
              </div>

              <div class="mt-10 grid grid-cols-1 gap-8 sm:mt-8 xl:grid-cols-[1.1fr_1fr]">
                <div class="flex flex-col gap-4">
                  <h3 class="text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">{s.data.title}</h3>
                  <p class="leading-relaxed text-ink-muted">{s.data.whyChooseIt}</p>
                  <div class="flex flex-wrap gap-2 pt-1">
                    {s.data.series.map((x) => (
                      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface-alt px-3.5 py-1.5 text-xs font-bold text-ink" title={x.tagline}>
                        <span class={`h-2 w-2 rounded-full ${x.series === 'Inventa' ? 'bg-primary-600' : 'bg-accent-500'}`}></span>
                        {x.series} series
                      </span>
                    ))}
                  </div>
                </div>
                <ul class="flex flex-col gap-3">
                  {s.data.benefits.map((b) => (
                    <li class="flex gap-3 rounded-2xl border border-border bg-white p-4">
                      <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-100 text-accent-700">
                        <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      </span>
                      <span class="flex flex-col"><strong class="text-sm text-ink">{b.title}</strong><span class="text-sm leading-snug text-ink-muted">{b.description}</span></span>
                    </li>
                  ))}
                </ul>
              </div>
              <a href={`/${s.id}/`} class="group mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-primary-700 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary-800">
                Explore {s.data.shortName} {s.data.category === 'window' ? 'windows' : 'doors'}
                <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  import { scrollToEl } from '../../utils/motion';

  const root = document.querySelector<HTMLElement>('[data-system-explorer]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-sys-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-sys-panel]'));

    const select = (id: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.sysTab === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
        const list = t.parentElement;
        if (on && list && list.scrollWidth > list.clientWidth + 4)
          list.scrollTo({ left: t.offsetLeft - list.clientWidth / 2 + t.clientWidth / 2, behavior: 'smooth' });
      });
      panels.forEach((p) => p.classList.toggle('is-active', p.dataset.sysPanel === id));
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.sysTab!));
      t.addEventListener('keydown', (e) => {
        const fwd = e.key === 'ArrowDown' || e.key === 'ArrowRight';
        const back = e.key === 'ArrowUp' || e.key === 'ArrowLeft';
        if (!fwd && !back) return;
        e.preventDefault();
        select(tabs[(i + (fwd ? 1 : -1) + tabs.length) % tabs.length].dataset.sysTab!, true);
      });
    });

    window.addEventListener('select-system', (e) => {
      select((e as CustomEvent<string>).detail);
      scrollToEl(root);
    });
  }
</script>
