---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { laminateInfo } from '../../data/brand';

import walnut from '../../assets/images/brochure/laminates/walnut.jpg';
import mahogany from '../../assets/images/brochure/laminates/mahogany.jpg';
import anthracite from '../../assets/images/brochure/laminates/anthracite.jpg';
import goldenOak from '../../assets/images/brochure/laminates/golden-oak.jpg';
import darkOak from '../../assets/images/brochure/laminates/dark-oak.jpg';
import fxBlack from '../../assets/images/brochure/laminates/fx-black.jpg';
import silver from '../../assets/images/brochure/laminates/silver-brush.jpg';
import swWalnut from '../../assets/images/brochure/laminates/swatch-walnut.jpg';
import swMahogany from '../../assets/images/brochure/laminates/swatch-mahogany.jpg';
import swAnthracite from '../../assets/images/brochure/laminates/swatch-anthracite.jpg';
import swGoldenOak from '../../assets/images/brochure/laminates/swatch-golden-oak.jpg';
import swDarkOak from '../../assets/images/brochure/laminates/swatch-dark-oak.jpg';
import swFxBlack from '../../assets/images/brochure/laminates/swatch-fx-black.jpg';
import swSilver from '../../assets/images/brochure/laminates/swatch-silver-brush.jpg';

interface Finish {
  id: string;
  name: string;
  type: string;
  mood: string;
  text: string;
  room: ImageMetadata;
  swatch: ImageMetadata;
}

const finishes: Finish[] = [
  { id: 'walnut', name: 'Walnut', type: 'Wood grain', mood: 'Rugged & natural', text: 'Rugged and bare, walnut brings the lines of nature closer to home — a perfect companion for an object that wants to stand apart.', room: walnut, swatch: swWalnut },
  { id: 'mahogany', name: 'Mahogany', type: 'Wood grain', mood: 'Warm & comforting', text: 'A deep shade of the original colour. Authentic in appearance, its parallel gradients and speckles conjure up a sense of comfort.', room: mahogany, swatch: swMahogany },
  { id: 'golden-oak', name: 'Golden Oak', type: 'Wood grain', mood: 'Radiant & regal', text: 'These oak finishes shimmer out from the rest and elevate the ambience into something regal, with a radiant yellow-brown tone.', room: goldenOak, swatch: swGoldenOak },
  { id: 'dark-oak', name: 'Dark Oak', type: 'Wood grain', mood: 'Classic & versatile', text: 'The quintessential colour of the woods — an earthy brown that slips seamlessly into a modern piece or a rustic one.', room: darkOak, swatch: swDarkOak },
  { id: 'anthracite', name: 'Anthracite Grey', type: 'Contemporary', mood: 'Modern & minimal', text: 'A metallic-toned grey with a uniform finish — stern, sleek and ideal for modern or minimalist structures.', room: anthracite, swatch: swAnthracite },
  { id: 'fx-black', name: 'FX Black', type: 'Contemporary', mood: 'Dark & handsome', text: 'Sheer smoothness and a powerful black tone make it an ideal frame — and it is highly endurable too.', room: fxBlack, swatch: swFxBlack },
  { id: 'silver', name: 'Silver Brush', type: 'Metallic', mood: 'Calm & serene', text: 'All about the tone and feel: a natural sheen and smooth sensation that projects calmness and serenity.', room: silver, swatch: swSilver },
];
---

<section id="finishes" class="relative overflow-hidden bg-neutral-950 py-20 text-white sm:py-28" data-finish-studio>
  <div class="pointer-events-none absolute -left-40 top-20 h-[32rem] w-[32rem] rounded-full bg-primary-700/25 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-40 bottom-0 h-[28rem] w-[28rem] rounded-full bg-accent-600/20 blur-3xl" aria-hidden="true"></div>

  <div class="container-prom relative flex flex-col gap-12">
    <div class="flex max-w-2xl flex-col gap-4">
      <span class="reveal text-xs font-bold uppercase tracking-[0.14em] text-accent-300">Finish studio</span>
      <h2 class="reveal text-3xl font-extrabold leading-[1.1] tracking-tight sm:text-4xl lg:text-[2.75rem]">Windows don't have to be white.</h2>
      <p class="reveal text-lg leading-relaxed text-white/75">Choose a finish and watch the room change. Every laminate is {laminateInfo.origin.toLowerCase()} and carries a {laminateInfo.warranty}.</p>
    </div>

    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-16">
      <div class="reveal relative" data-reveal="left">
        <div class="relative aspect-square w-full overflow-hidden rounded-[2rem] bg-neutral-900 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.7)] sm:aspect-[5/4]">
          {finishes.map((f, i) => (
            <div class={`finish-room absolute inset-0 transition-all duration-[900ms] ease-out ${i === 0 ? 'is-active' : ''}`} data-finish-room={f.id}>
              <Image src={f.room} alt={`Room with ${f.name} finish uPVC windows`} class="h-full w-full object-cover" widths={[640, 960, 1100]} sizes="(min-width: 1024px) 55vw, 100vw" loading={i === 0 ? 'eager' : 'lazy'} />
            </div>
          ))}
        </div>
        <div class="absolute -bottom-5 left-5 flex items-center gap-3 rounded-2xl bg-white px-4 py-3 text-ink shadow-[var(--shadow-pop)] sm:left-8">
          <span class="relative h-10 w-10 shrink-0 overflow-hidden rounded-full border-2 border-white shadow ring-1 ring-border" aria-hidden="true">
            {finishes.map((f, i) => (
              <span class={`finish-chip absolute h-10 w-10 transition-opacity duration-500 ${i === 0 ? 'opacity-100' : 'opacity-0'}`} data-finish-chip={f.id}>
                <Image src={f.swatch} alt="" class="h-full w-full object-cover" width={80} height={80} />
              </span>
            ))}
          </span>
          <span class="flex flex-col leading-tight">
            <span class="text-[10px] font-bold uppercase tracking-wide text-ink-muted">Selected finish</span>
            <strong class="text-sm" data-finish-live>{finishes[0].name}</strong>
          </span>
        </div>
      </div>

      <div class="flex flex-col gap-8 pt-6 lg:pt-0">
        <div class="stack min-h-[190px]">
          {finishes.map((f, i) => (
            <div class={`fade-panel flex flex-col gap-3 ${i === 0 ? 'is-active' : ''}`} data-finish-text={f.id}>
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-bold uppercase tracking-wide text-accent-300">{f.type}</span>
                <span class="text-sm font-semibold text-white/60">{f.mood}</span>
              </div>
              <h3 class="text-4xl font-extrabold tracking-tight sm:text-5xl">{f.name}</h3>
              <p class="max-w-md leading-relaxed text-white/75">{f.text}</p>
            </div>
          ))}
        </div>

        <div role="radiogroup" aria-label="Choose a finish" class="grid grid-cols-4 gap-3 sm:grid-cols-7 lg:grid-cols-4 xl:grid-cols-7" data-stagger="50">
          {finishes.map((f, i) => (
            <button
              type="button"
              role="radio"
              aria-checked={i === 0 ? 'true' : 'false'}
              aria-label={f.name}
              title={f.name}
              data-finish-swatch={f.id}
              class="reveal group relative aspect-[3/4] overflow-hidden rounded-xl border-2 border-transparent outline-offset-4 transition-all duration-300 hover:-translate-y-1.5 aria-checked:-translate-y-2 aria-checked:border-white aria-checked:shadow-[0_14px_30px_-8px_rgba(255,255,255,0.3)]"
            >
              <Image src={f.swatch} alt="" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" widths={[120, 200]} sizes="90px" />
              <span class="absolute inset-0 flex items-end bg-gradient-to-t from-black/60 to-transparent p-1.5 opacity-0 transition-opacity group-hover:opacity-100 group-aria-checked:opacity-100">
                <span class="text-[10px] font-bold leading-tight">{f.name}</span>
              </span>
            </button>
          ))}
        </div>

        <ul class="grid grid-cols-1 gap-3 text-sm text-white/80 sm:grid-cols-2">
          <li class="flex gap-2.5"><span class="text-accent-300">✓</span> PVDF-equipped coating for extreme weather resistance</li>
          <li class="flex gap-2.5"><span class="text-accent-300">✓</span> Colour stability &amp; gloss retention</li>
          <li class="flex gap-2.5"><span class="text-accent-300">✓</span> European hot-melt lamination, PUR adhesives</li>
          <li class="flex gap-2.5"><span class="text-accent-300">✓</span> Easy maintenance, crack resistant</li>
        </ul>

        <div class="flex flex-wrap gap-3">
          <a href="/quote/" class="group inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-semibold text-primary-800 transition-colors hover:bg-accent-100">
            Get a quote in this finish
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
          <a href="/downloads/Prominance-Laminates-Brochure.pdf" download="Prominance-Laminates-Brochure.pdf" class="inline-flex items-center gap-2 rounded-full border border-white/30 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10">
            Laminates brochure (PDF)
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .finish-room {
    opacity: 0;
    transform: scale(1.08);
    visibility: hidden;
  }
  .finish-room.is-active {
    opacity: 1;
    transform: scale(1);
    visibility: visible;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-finish-studio]');
  if (root) {
    const swatches = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-finish-swatch]'));
    const live = root.querySelector<HTMLElement>('[data-finish-live]');

    const select = (id: string, focus = false) => {
      swatches.forEach((s) => {
        const on = s.dataset.finishSwatch === id;
        s.setAttribute('aria-checked', String(on));
        s.tabIndex = on ? 0 : -1;
        if (on) {
          if (focus) s.focus();
          if (live) live.textContent = s.getAttribute('aria-label');
        }
      });
      root.querySelectorAll<HTMLElement>('[data-finish-room]').forEach((r) => r.classList.toggle('is-active', r.dataset.finishRoom === id));
      root.querySelectorAll<HTMLElement>('[data-finish-text]').forEach((r) => r.classList.toggle('is-active', r.dataset.finishText === id));
      root.querySelectorAll<HTMLElement>('[data-finish-chip]').forEach((r) => {
        const on = r.dataset.finishChip === id;
        r.classList.toggle('opacity-100', on);
        r.classList.toggle('opacity-0', !on);
      });
    };

    swatches.forEach((s, i) => {
      s.tabIndex = i === 0 ? 0 : -1;
      s.addEventListener('click', () => select(s.dataset.finishSwatch!));
      s.addEventListener('mouseenter', () => {
        if (window.matchMedia('(hover: hover)').matches) select(s.dataset.finishSwatch!);
      });
      s.addEventListener('keydown', (e) => {
        const fwd = e.key === 'ArrowRight' || e.key === 'ArrowDown';
        const back = e.key === 'ArrowLeft' || e.key === 'ArrowUp';
        if (!fwd && !back) return;
        e.preventDefault();
        select(swatches[(i + (fwd ? 1 : -1) + swatches.length) % swatches.length].dataset.finishSwatch!, true);
      });
    });
  }
</script>
