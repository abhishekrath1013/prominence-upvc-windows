---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import { resolveImage } from '../../data/images';

const colours = (await getCollection('colours')).sort((a, b) => a.data.order - b.data.order);
---

<section class="bg-surface-alt py-20 sm:py-28">
  <div class="container-prom flex flex-col items-center gap-10 text-center">
    <SectionHeading
      eyebrow="Colour experience"
      heading="Not just white. Choose a finish that fits your home."
      description="Wood grains and solid contemporary colours, imported from Europe with a 20-year warranty."
      align="center"
    />

    <div class="flex flex-wrap justify-center gap-4">
      {colours.map((c) => (
        <div class="reveal flex flex-col items-center gap-2">
          <div class="h-16 w-16 overflow-hidden rounded-full border-4 border-white shadow-[var(--shadow-card)] sm:h-20 sm:w-20">
            {c.data.image ? (
              <Image src={resolveImage(c.data.image)} alt={c.data.name} class="h-full w-full object-cover" width={80} height={80} />
            ) : (
              <div class="h-full w-full" style={`background-color:${c.data.swatchHex}`}></div>
            )}
          </div>
          <span class="text-xs font-semibold text-ink-muted">{c.data.name}</span>
        </div>
      ))}
    </div>

    <Button href="/colours/" variant="primary" size="lg">Explore Finishes</Button>
  </div>
</section>
