---
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import villa1 from '../../assets/images/stock/villa-glass-pool-indoor-outdoor.jpg';
import villa2 from '../../assets/images/stock/modern-house-wood-cladding.jpg';
import brickHome from '../../assets/images/stock/brick-family-home.jpg';

const showcases = [
  { type: 'Villa', product: 'Slide & Fold Doors', img: villa1 },
  { type: 'Independent House', product: 'Casement Windows', img: villa2 },
  { type: 'Family Home', product: 'Sliding Windows', img: brickHome },
];
---

<section class="bg-surface-alt py-20 sm:py-28">
  <div class="container-prom flex flex-col gap-10">
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <SectionHeading
        eyebrow="See Prominance in real homes"
        heading="Picture it in your home."
        description="From compact apartments to open villas — the right window style changes how a space feels."
      />
      <Button href="/projects/" variant="ghost" class="shrink-0">See more homes</Button>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      {showcases.map((s, i) => (
        <a href="/projects/" class="reveal group relative flex aspect-[3/4] overflow-hidden rounded-2xl" data-reveal-delay={i * 90}>
          <Image src={s.img} alt={`${s.type} with Prominance ${s.product}`} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" widths={[400, 600]} sizes="(min-width: 640px) 33vw, 100vw" />
          <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/80 via-neutral-950/10 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 flex flex-col gap-0.5 p-5 text-white">
            <span class="text-xs font-bold uppercase tracking-wide text-white/70">{s.type}</span>
            <span class="text-lg font-bold">{s.product}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
