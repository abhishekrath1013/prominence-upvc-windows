---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';

interface Props {
  categoryLabel: string;
  title: string;
  whatIsIt: string;
  heroImage: ImageMetadata;
  idealFor: string[];
}
const { categoryLabel, title, whatIsIt, heroImage, idealFor } = Astro.props;
---

<section class="bg-surface-alt">
  <div class="container-prom grid grid-cols-1 items-center gap-10 py-14 sm:py-20 lg:grid-cols-2 lg:gap-16">
    <div class="reveal flex flex-col gap-6">
      <Badge variant="accent">{categoryLabel}</Badge>
      <h1 class="text-4xl font-extrabold leading-[1.05] tracking-tight text-ink sm:text-5xl">{title}</h1>
      <p class="max-w-lg text-lg leading-relaxed text-ink-muted">{whatIsIt}</p>
      <div class="flex flex-wrap gap-2">
        {idealFor.map((tag) => (
          <span class="rounded-full border border-border bg-white px-3.5 py-1.5 text-xs font-semibold text-ink-muted">{tag}</span>
        ))}
      </div>
      <div class="flex flex-wrap gap-3 pt-2">
        <Button href="/quote/" variant="primary" size="lg">Get a Quote</Button>
        <Button href="#specs" variant="ghost" size="lg">View Specifications</Button>
      </div>
    </div>
    <div class="reveal overflow-hidden rounded-3xl bg-white shadow-[var(--shadow-card)]" data-reveal-delay="120">
      <Image src={heroImage} alt={title} class="aspect-[4/3] w-full object-cover" widths={[500, 800]} sizes="(min-width: 1024px) 45vw, 90vw" loading="eager" />
    </div>
  </div>
</section>
