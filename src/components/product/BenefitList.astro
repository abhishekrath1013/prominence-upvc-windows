---
interface Benefit {
  title: string;
  description: string;
}
interface Props {
  heading: string;
  benefits: Benefit[];
}
const { heading, benefits } = Astro.props;
---

<section class="py-16 sm:py-20">
  <div class="container-prom flex flex-col gap-10">
    <h2 class="reveal text-2xl font-extrabold text-ink sm:text-3xl">{heading}</h2>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      {benefits.map((b, i) => (
        <div class="reveal flex flex-col gap-2 rounded-2xl border border-border bg-white p-6" data-reveal-delay={i * 80}>
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-accent-50 text-accent-700">
            <svg class="h-4.5 w-4.5" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <h3 class="font-bold text-ink">{b.title}</h3>
          <p class="text-[15px] leading-relaxed text-ink-muted">{b.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
