---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  heading: string;
  description: string;
  image: ImageMetadata;
}
const { eyebrow, heading, description, image } = Astro.props;
---

<section class="relative flex min-h-[52vh] items-end overflow-hidden bg-neutral-900">
  <Image src={image} alt="" class="absolute inset-0 h-full w-full object-cover" widths={[800, 1600, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="absolute inset-0 bg-gradient-to-t from-neutral-950/85 via-neutral-950/30 to-neutral-950/10" aria-hidden="true"></div>
  <div class="container-prom reveal relative z-10 flex flex-col gap-4 pb-14 pt-32">
    <span class="text-xs font-bold uppercase tracking-[0.14em] text-accent-400">{eyebrow}</span>
    <h1 class="max-w-2xl text-4xl font-extrabold leading-[1.05] text-white sm:text-5xl lg:text-6xl">{heading}</h1>
    <p class="max-w-xl text-lg text-white/80">{description}</p>
  </div>
</section>
