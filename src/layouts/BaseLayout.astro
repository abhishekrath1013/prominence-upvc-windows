---
import { Font } from 'astro:assets';
import '../styles/global.css';
import SiteNav from '../components/layout/SiteNav.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import StickyCTA from '../components/layout/StickyCTA.astro';
import BrochureFab from '../components/layout/BrochureFab.astro';
import CustomCursor from '../components/layout/CustomCursor.astro';
import { brand, contact } from '../data/brand';

interface Props {
  title: string;
  description: string;
  ogImagePath?: string;
  noIndex?: boolean;
  structuredData?: Record<string, unknown>;
  /** "none" = the page draws its own top bar (the home page puts it inside the hero) */
  nav?: 'default' | 'none';
}

const { title, description, noIndex = false, structuredData, nav = 'default' } = Astro.props;
const isHome = Astro.url.pathname === '/';
const pageTitle = title.includes(brand.name) ? title : `${title} | ${brand.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: brand.name,
  legalName: brand.legalName,
  url: 'https://prominance.com',
  logo: 'https://prominance.com/favicon.png',
  description: brand.short,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.hq.line1,
    addressLocality: 'Coimbatore',
    addressRegion: 'Tamil Nadu',
    addressCountry: 'IN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: contact.tollFree,
    contactType: 'customer service',
    email: contact.email,
  },
  sameAs: Object.values(contact.social),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={brand.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#ffffff" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <script is:inline>document.documentElement.classList.add('js');</script>
    <Font cssVariable="--font-sans-raw" preload />
    <Font cssVariable="--font-poppins-raw" preload />
    <slot name="head" />
  </head>
  <body class="bg-surface font-sans text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-2.5 focus:text-sm focus:text-bone"
    >
      Skip to content
    </a>
    {!isHome && (
      <div class="pointer-events-none fixed inset-x-0 top-0 z-[160] h-[2px] bg-transparent" aria-hidden="true">
        <div class="brand-bar h-full origin-left" style="transform: scaleX(0)" data-scroll-progress></div>
      </div>
    )}

    {nav !== 'none' && <SiteNav variant="page" />}

    <main id="main-content" class="relative z-[2] bg-surface">
      <slot />
    </main>
    <SiteFooter />
    {!isHome && <div class="h-[68px] lg:hidden" aria-hidden="true" />}

    {!isHome && <StickyCTA />}
    {!isHome && <BrochureFab />}
    {!isHome && <CustomCursor />}
    <script>
      import { initLenis } from '../scripts/site';
      import { initMotion } from '../utils/motion';
      initLenis(); // smooth scrolling, same engine as the aluminium site
      initMotion();
    </script>
  </body>
</html>
