@import 'tailwindcss';
@import '@fontsource-variable/inter-tight';
@import '@fontsource-variable/cormorant';
@import '@fontsource-variable/cormorant/wght-italic.css';

@theme {
  /* ---- Typography: refined serif display + quiet grotesque body ---- */
  --font-sans: 'Inter Tight Variable', 'Inter Tight', system-ui, -apple-system, sans-serif;
  --font-display: 'Cormorant Variable', 'Cormorant Garamond', Georgia, 'Times New Roman', serif;

  /* ---- Ivory surfaces ---- */
  --color-bone: #faf7f2;
  --color-bone-deep: #f1ebe0;
  --color-ink-deep: #1b1916;
  --color-stone: #8b8377;

  /* ---- Primary: deep slate-navy (the Prominance blue, quietened for a premium feel) ---- */
  --color-primary-50: #f3f5f7;
  --color-primary-100: #e4e9ee;
  --color-primary-200: #c6d0da;
  --color-primary-300: #9cafbf;
  --color-primary-400: #6c8499;
  --color-primary-500: #4a627b;
  --color-primary-600: #344b63;
  --color-primary-700: #263c52;
  --color-primary-800: #1c2f41;
  --color-primary-900: #142231;
  --color-primary-950: #0c1520;

  /* ---- Accent: champagne bronze ---- */
  --color-accent-50: #faf6ee;
  --color-accent-100: #f3eadb;
  --color-accent-200: #e7d6b6;
  --color-accent-300: #d7bd8e;
  --color-accent-400: #c4a169;
  --color-accent-500: #b08a4d;
  --color-accent-600: #9a7439;
  --color-accent-700: #7f5d2c;
  --color-accent-800: #654925;
  --color-accent-900: #4b361c;
  --color-accent-950: #2d200f;

  /* ---- Warm neutrals ---- */
  --color-neutral-0: #ffffff;
  --color-neutral-50: #fbf9f5;
  --color-neutral-100: #f4f0e8;
  --color-neutral-200: #e8e1d4;
  --color-neutral-300: #d6ccba;
  --color-neutral-400: #aea28f;
  --color-neutral-500: #81786a;
  --color-neutral-600: #5f574c;
  --color-neutral-700: #443e36;
  --color-neutral-800: #2c2823;
  --color-neutral-900: #1d1a16;
  --color-neutral-950: #100e0b;

  /* ---- Semantic ---- */
  --color-ink: var(--color-ink-deep);
  --color-ink-muted: var(--color-neutral-600);
  --color-surface: var(--color-bone);
  --color-surface-alt: var(--color-bone-deep);
  --color-surface-strong: var(--color-neutral-100);
  --color-border: #e6dfd1;

  /* ---- Motion ---- */
  --ease-smooth: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-luxe: cubic-bezier(0.65, 0, 0.35, 1);

  /* ---- Shadows: long, soft, warm ---- */
  --shadow-card: 0 1px 1px rgba(60, 45, 20, 0.03), 0 18px 40px -22px rgba(60, 45, 20, 0.18);
  --shadow-card-hover: 0 2px 2px rgba(60, 45, 20, 0.04), 0 30px 60px -28px rgba(60, 45, 20, 0.28);
  --shadow-pop: 0 30px 70px -30px rgba(38, 60, 82, 0.4);
}

@layer base {
  html {
    scroll-behavior: auto;
  }

  body {
    background-color: var(--color-surface);
    color: var(--color-ink);
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    overflow-x: clip;
  }

  ::selection {
    background: var(--color-accent-200);
    color: var(--color-ink-deep);
  }

  :focus-visible {
    outline: 1.5px solid var(--color-accent-600);
    outline-offset: 3px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
}

/* ScrollSmoother shell: the wrapper is fixed, the content is translated by GSAP.
   Anything `position: fixed` (header, floating buttons, cursor) lives OUTSIDE #smooth-content. */
html.has-smoother,
html.has-smoother body {
  overscroll-behavior: none;
}
#smooth-content {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
}

@layer components {
  .container-prom {
    width: 100%;
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  @media (min-width: 768px) {
    .container-prom {
      padding-inline: 2.5rem;
    }
  }

  .js .reveal {
    opacity: 0;
    transform: translateY(28px);
  }
  .js .reveal[data-reveal='left'] { transform: translateX(-48px); }
  .js .reveal[data-reveal='right'] { transform: translateX(48px); }
  .js .reveal[data-reveal='scale'] { transform: scale(0.96); }
  .js .reveal[data-reveal='fade'] { transform: none; }

  .js .reveal.is-visible {
    opacity: 1;
    transform: none;
    transition:
      opacity 1.1s var(--ease-smooth),
      transform 1.2s var(--ease-smooth);
  }

  /* Image curtain: a soft wipe that opens upwards as the image enters view */
  .js .img-reveal {
    clip-path: inset(0 0 100% 0 round 1rem);
    transform: scale(1.04);
  }
  .js .img-reveal.is-visible {
    clip-path: inset(0 0 0 0 round 1rem);
    transform: none;
    transition:
      clip-path 1.5s var(--ease-luxe),
      transform 1.8s var(--ease-smooth);
  }

  /* Brand hairline (bronze to slate) */
  .brand-bar {
    background: linear-gradient(90deg, var(--color-accent-400), var(--color-primary-700));
  }
  .text-brand-gradient {
    background: linear-gradient(90deg, var(--color-accent-500), var(--color-primary-500));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-word {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .hero-word > span {
    display: inline-block;
    transform: translateY(110%);
    animation: word-rise 1.1s var(--ease-smooth) forwards;
    animation-delay: calc(var(--i, 0) * 90ms + 200ms);
  }
  @keyframes word-rise {
    to { transform: translateY(0); }
  }

  @keyframes kenburns {
    from { transform: scale(1.04); }
    to { transform: scale(1.12); }
  }
  @keyframes float-y {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }
  @keyframes cue-bounce {
    0%, 100% { transform: translateY(0); opacity: 1; }
    60% { transform: translateY(8px); opacity: 0.3; }
  }
  @keyframes spin-slow {
    to { transform: rotate(360deg); }
  }
  @keyframes anatomy-progress {
    to { scale: 1 1; }
  }
  @keyframes fab-ring {
    0% { box-shadow: 0 0 0 0 rgba(154, 116, 57, 0.4); }
    100% { box-shadow: 0 0 0 16px rgba(154, 116, 57, 0); }
  }

  .stack { display: grid; grid-template-columns: minmax(0, 1fr); }
  .stack > * { grid-area: 1 / 1; }
  .fade-panel {
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px);
    transition:
      opacity 0.6s var(--ease-smooth),
      transform 0.8s var(--ease-smooth),
      visibility 0s linear 0.6s;
  }
  .fade-panel.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .no-scrollbar { scrollbar-width: none; }
  .no-scrollbar::-webkit-scrollbar { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .js .reveal,
    .js .img-reveal {
      opacity: 1;
      transform: none;
      clip-path: none;
    }
    .hero-word > span {
      transform: none;
      animation: none;
    }
  }
}

@layer components {
  .display {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent-700);
  }
  .eyebrow::before {
    content: '';
    width: 2.2rem;
    height: 1px;
    background: currentColor;
    opacity: 0.7;
  }
  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid currentColor;
    transition: gap 0.45s var(--ease-smooth), opacity 0.2s;
  }
  .link-arrow:hover { gap: 1.25rem; }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 50s linear infinite;
  }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }
}

/* Editorial typography across every page. Kept unlayered so it wins over utility
   classes like `font-extrabold` that the older templates still carry. */
h1,
h2 {
  font-family: var(--font-display);
  font-weight: 450;
  letter-spacing: -0.012em;
}
h1 {
  font-size: clamp(2.7rem, 5.4vw, 5rem);
  line-height: 1.02;
}
h2 {
  font-size: clamp(2rem, 3.6vw, 3.2rem);
  line-height: 1.08;
}
h3:not(.font-sans) {
  font-family: var(--font-display);
  font-weight: 500;
  letter-spacing: -0.005em;
}
